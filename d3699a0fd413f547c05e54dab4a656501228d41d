using System.Runtime.InteropServices;
using System.Text.Json;
using Avalonia.Threading;

namespace FlashMacOS.Browser.WebKit.Diagnostics;

public static partial class NativeWindowDiagnostics
{
    internal static Task<JsonElement> SnapshotAsync() => Dispatcher.UIThread.InvokeAsync(() =>
    {
        using var document = JsonDocument.Parse(Marshal.PtrToStringUTF8(Snapshot())!);
        return document.RootElement.Clone();
    }).GetTask();

    public static int WindowNumber(nint window) => GetWindowNumber(window);

    [LibraryImport("FlashMacOSWebKit", EntryPoint = "fm_window_number")]
    private static partial int GetWindowNumber(nint window);

    [LibraryImport("FlashMacOSWebKit", EntryPoint = "fm_window_snapshot")]
    private static partial nint Snapshot();
}
