        Assert.AreEqual(Hash(await File.ReadAllBytesAsync(path)), result.FileRevision.Sha256);
    }

    [TestMethod]
    [DataRow("marker")]
    [DataRow("external")]
    [DataRow("damaged")]
    public async Task UnsupportedOrDamagedFilesRemainReadOnlyAndExportExactOriginals(string kind)
    {
        using var directory = new TemporaryDirectory(); var path = directory.GetPath("unknown.sol"); var bytes = Unsupported(kind); await File.WriteAllBytesAsync(path, bytes);
        await using var editor = await SolEditorSession.OpenAsync(new SolCodec(), new SolFileStorage(), path);
        Assert.IsTrue(editor.Current.IsReadOnly); Assert.IsNull(editor.Current.Document); Assert.HasCount(1, editor.Current.Diagnostics);
        Assert.AreEqual(kind == "damaged" ? "InvalidHeader" : kind == "external" ? "UnknownExternalizable" : "UnsupportedMarker", editor.Current.Diagnostics[0].Code);
        if (kind != "damaged") Assert.AreEqual(kind == "external" ? 24 : 25, editor.Current.Diagnostics[0].Offset);
        var state = editor.Current;
        await Assert.ThrowsExactlyAsync<InvalidOperationException>(() => editor.SaveAsync(state.Version).AsTask());
        await Assert.ThrowsExactlyAsync<InvalidOperationException>(() => editor.ApplyAsync(new RenameSolDocument("bad"), state.Version).AsTask());
        Assert.AreSame(state, editor.Current); await editor.ExportOriginalAsync(directory.GetPath("raw.sol"));
        CollectionAssert.AreEqual(bytes, await File.ReadAllBytesAsync(directory.GetPath("raw.sol")));
        await Assert.ThrowsExactlyAsync<PersistenceConflictException>(() => editor.ExportOriginalAsync(path).AsTask());
        CollectionAssert.AreEqual(bytes, await File.ReadAllBytesAsync(path)); Assert.IsFalse(File.Exists(path + ".bak"));
    }

    [TestMethod]
    public async Task BackupRecoveryPreservesBadCurrentAndValidBackupBeforeRestoring()
    {
        using var directory = new TemporaryDirectory(); var path = directory.GetPath("recover.sol"); var backup = await File.ReadAllBytesAsync(TestAssets.Sol("mao.sol"));
        var bad = Convert.FromHexString("00ff"); await File.WriteAllBytesAsync(path, bad); await File.WriteAllBytesAsync(path + ".bak", backup);
        await using var editor = await SolEditorSession.OpenAsync(new SolCodec(), new SolFileStorage(), path);
        var result = await editor.RecoverBackupAsync(editor.Current.Version);
        Assert.IsFalse(result.Snapshot.IsReadOnly); Assert.IsFalse(result.Snapshot.IsDirty);
        Assert.IsNotNull(result.ArchivedCurrentPath); CollectionAssert.AreEqual(bad, await File.ReadAllBytesAsync(result.ArchivedCurrentPath));
