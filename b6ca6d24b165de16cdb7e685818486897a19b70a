    [TestMethod]
    [DataRow("settings.sol")]
    [DataRow("mao.sol")]
    [DataRow("pvz.sol")]
    [DataRow("FBCookie.sol")]
    [DataRow("RuffleTest.sol")]
    public async Task OriginalBytesAndBackupRemainRecoverableForAllExistingSolFiles(string name)
    {
        using var directory = new TemporaryDirectory(); var path = directory.GetPath(name); File.Copy(TestAssets.Sol(name), path);
        var bytes = await File.ReadAllBytesAsync(path); var codec = new SolCodec();
        await using var editor = await SolEditorSession.OpenAsync(codec, new SolFileStorage(), path);
        Assert.IsFalse(editor.Current.IsReadOnly); Assert.IsFalse(editor.Current.IsDirty);
        Assert.AreEqual(Hash(bytes), editor.Current.FileRevision.Sha256); CollectionAssert.AreEqual(bytes, editor.OriginalBytes.ToArray());
        Assert.IsFalse(File.Exists(path + ".bak"));
        await editor.ExportOriginalAsync(directory.GetPath("原件副本.sol"));
        CollectionAssert.AreEqual(bytes, await File.ReadAllBytesAsync(directory.GetPath("原件副本.sol")));
        var document = editor.Current.Document!; await editor.SaveAsync(editor.Current.Version);
        CollectionAssert.AreEqual(bytes, await File.ReadAllBytesAsync(path + ".bak"));
        Assert.IsTrue(AmfGraphEquality.Equivalent(document.Graph, codec.Decode(await File.ReadAllBytesAsync(path)).Graph));
        Assert.AreEqual(Hash(await File.ReadAllBytesAsync(path)), editor.Current.FileRevision.Sha256);
        CollectionAssert.AreEqual(bytes, await File.ReadAllBytesAsync(TestAssets.Sol(name)));
    }

    [TestMethod]
    public async Task RootObjectAndArrayEditsUndoRedoAndReloadPersistTypedValues()
    {
        using var directory = new TemporaryDirectory(); var codec = new SolCodec();
        await using var editor = SolEditorSession.Create(codec, new SolFileStorage(), "draft", SolEncoding.Amf3);
        Assert.IsTrue(editor.Current.IsDirty);
        await Apply(new InsertSolEntry(0, "score", new AmfInteger(1)));
        var array = new AmfArrayNode(new(7), AmfArrayKind.Amf3Mixed, [new AmfInteger(1)], [new("coins", new AmfInteger(10))]);
        await Apply(new AddSolGraphEntry(1, "inventory", new AmfReference(array.Id), [array]));
        var item = new AmfObjectNode(new(8), new AmfTraits("Player", true), properties: [new("name", new AmfString("old"))]);
        await Apply(new AddSolGraphEntry(2, "player", new AmfReference(item.Id), [item]));
        await Apply(new ReplaceSolNode(new AmfArrayNode(array.Id, AmfArrayKind.Amf3Mixed,
            [new AmfInteger(99), new AmfString("火")], [new("coins", new AmfInteger(100))])));
        await Apply(new ReplaceSolNode(new AmfObjectNode(item.Id, item.Traits, properties: [new("name", new AmfString("小摩尔")), new("active", new AmfBoolean(true))])));
        await Apply(new ReplaceSolEntry(0, "level", new AmfInteger(42)));
        await Apply(new InsertSolEntry(3, "temporary", AmfNull.Instance)); await Apply(new RemoveSolEntry(3));
        await Apply(new RenameSolDocument("中文存档"));
        await editor.UndoAsync(editor.Current.Version); Assert.AreEqual("draft", editor.Current.Document!.Name);
        await editor.RedoAsync(editor.Current.Version); Assert.AreEqual("中文存档", editor.Current.Document!.Name);
        var path = directory.GetPath("中文 空格/编辑结果.sol"); var saved = await editor.SaveAsAsync(path, editor.Current.Version);
        Assert.IsFalse(saved.IsDirty); Assert.AreEqual(path, saved.Path);
        var read = codec.Decode(await File.ReadAllBytesAsync(path)); Assert.IsTrue(AmfGraphEquality.Equivalent(saved.Document!.Graph, read.Graph));
        Assert.AreEqual(42, ((AmfInteger)read.Graph.Entries[0].Value).Value);
        var readArray = (AmfArrayNode)read.Graph.Nodes[((AmfReference)read.Graph.Entries[1].Value).Target];
        Assert.AreEqual("火", ((AmfString)readArray.Dense[1]).Value); Assert.AreEqual(100, ((AmfInteger)readArray.Associative[0].Value).Value);
        var readObject = (AmfObjectNode)read.Graph.Nodes[((AmfReference)read.Graph.Entries[2].Value).Target];
        Assert.AreEqual("Player", readObject.Traits.ClassName); Assert.AreEqual("小摩尔", ((AmfString)readObject.Properties[0].Value).Value);
        await editor.UndoAsync(editor.Current.Version); Assert.IsTrue(editor.Current.IsDirty);
        await editor.RedoAsync(editor.Current.Version); Assert.IsFalse(editor.Current.IsDirty);
        ValueTask<SolEditorSnapshot> Apply(ISolEdit edit) => editor.ApplyAsync(edit, editor.Current.Version);
    }

    [TestMethod]
    public async Task StaleEditsBranchesAndBoundedHistoryCannotOverwriteCurrentState()
    {
        await using var editor = SolEditorSession.Create(new SolCodec(), new SolFileStorage(), "start", SolEncoding.Amf3, maximumHistoryStates: 2);
        await editor.ApplyAsync(new RenameSolDocument("A"), 0);
        var same = editor.Current;
        await Assert.ThrowsExactlyAsync<SolEditConflictException>(() => editor.ApplyAsync(new RenameSolDocument("stale"), 0).AsTask());
        Assert.AreSame(same, editor.Current);
        await editor.ApplyAsync(new RenameSolDocument("B"), editor.Current.Version);
        await editor.ApplyAsync(new RenameSolDocument("C"), editor.Current.Version);
        await editor.UndoAsync(editor.Current.Version); Assert.AreEqual("B", editor.Current.Document!.Name); Assert.IsFalse(editor.Current.CanUndo);
        await editor.ApplyAsync(new RenameSolDocument("D"), editor.Current.Version); Assert.IsFalse(editor.Current.CanRedo);
        same = editor.Current;
        await Assert.ThrowsExactlyAsync<ArgumentException>(() => editor.ApplyAsync(new ReplaceSolNode(new AmfXmlNode(new(99), "", true)), editor.Current.Version).AsTask());
        Assert.AreSame(same, editor.Current);
    }

    [TestMethod]
    public async Task ConcurrentEditsWithTheSameVersionHaveOnlyOneWinner()
    {
        await using var editor = SolEditorSession.Create(new SolCodec(), new SolFileStorage(), "start", SolEncoding.Amf3);
        var first = editor.ApplyAsync(new RenameSolDocument("A"), 0).AsTask(); var second = editor.ApplyAsync(new RenameSolDocument("B"), 0).AsTask();
        await Assert.ThrowsExactlyAsync<SolEditConflictException>(() => Task.WhenAll(first, second));
        Assert.AreEqual(1, new[] { first, second }.Count(task => task.IsCompletedSuccessfully)); Assert.AreEqual(1L, editor.Current.Version);
    }

    [TestMethod]
    public async Task ExternalFileConflictPreservesDraftAndReloadRequiresAnExplicitOperation()
    {
        using var directory = new TemporaryDirectory(); var path = directory.GetPath("save.sol"); File.Copy(TestAssets.Sol("mao.sol"), path);
        var original = await File.ReadAllBytesAsync(path); var codec = new SolCodec();
        await using var editor = await SolEditorSession.OpenAsync(codec, new SolFileStorage(), path);
        await editor.ApplyAsync(new ReplaceSolEntry(0, "level", new AmfInteger(77)), editor.Current.Version); var draft = editor.Current;
        var external = codec.Encode(new("mao", SolEncoding.Amf3, new AmfGraph([new("level", new AmfInteger(88))]))); await File.WriteAllBytesAsync(path, external);
        await Assert.ThrowsExactlyAsync<PersistenceConflictException>(() => editor.SaveAsync(draft.Version).AsTask());
        Assert.AreSame(draft, editor.Current); Assert.IsTrue(editor.Current.IsDirty); CollectionAssert.AreEqual(external, await File.ReadAllBytesAsync(path));
        Assert.IsFalse(File.Exists(path + ".bak"));
        await editor.ReloadAsync(editor.Current.Version); Assert.AreEqual(88, ((AmfInteger)editor.Current.Document!.Graph.Entries[0].Value).Value);
        Assert.IsFalse(editor.Current.IsDirty); CollectionAssert.AreEqual(original, editor.OriginalBytes.ToArray());
    }

