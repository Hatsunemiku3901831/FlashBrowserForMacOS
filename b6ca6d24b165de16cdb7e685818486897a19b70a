    [TestMethod]
    public async Task RecoveryCommitFailurePreservesTheOriginalBackupAndMemoryForRetry()
    {
        using var directory = new TemporaryDirectory(); var path = directory.GetPath("recover.sol"); var bad = Convert.FromHexString("00ff");
        var backup = await File.ReadAllBytesAsync(TestAssets.Sol("mao.sol")); await File.WriteAllBytesAsync(path, bad); await File.WriteAllBytesAsync(path + ".bak", backup);
        var commits = 0; var storage = new SolFileStorage((stage, token) =>
        { if (stage == AtomicWriteStage.BeforeCommit && ++commits == 2) throw new IOException("Synthetic recovery commit failure"); return ValueTask.CompletedTask; });
        await using var editor = await SolEditorSession.OpenAsync(new SolCodec(), storage, path); var original = editor.Current;
        await Assert.ThrowsExactlyAsync<IOException>(() => editor.RecoverBackupAsync(original.Version).AsTask());
        Assert.AreSame(original, editor.Current); CollectionAssert.AreEqual(bad, await File.ReadAllBytesAsync(path));
        CollectionAssert.AreEqual(backup, await File.ReadAllBytesAsync(path + ".bak"));
        var archives = Directory.GetFiles(directory.RootPath, "*.recovery-*.sol"); Assert.HasCount(1, archives);
        CollectionAssert.AreEqual(bad, await File.ReadAllBytesAsync(archives[0]));
        await editor.RecoverBackupAsync(editor.Current.Version); CollectionAssert.AreEqual(backup, await File.ReadAllBytesAsync(path));
    }

    [TestMethod]
    public async Task ConversionPreviewCannotReplaceAnEditedDocumentEvenWithItsNewVersion()
    {
        var codec = new SolCodec(); await using var editor = SolEditorSession.Create(codec, new SolFileStorage(), "draft", SolEncoding.Amf3);
        await editor.ApplyAsync(new InsertSolEntry(0, "level", new AmfInteger(42)), editor.Current.Version);
        var plan = await new SolEncodingConversion(codec).AnalyzeAsync(editor.Current.Document!, SolEncoding.Amf0);
        await editor.ApplyAsync(new RenameSolDocument("changed"), editor.Current.Version); var current = editor.Current;
        await Assert.ThrowsExactlyAsync<SolEditConflictException>(() => editor.ApplyAsync(new ApplySolConversion(plan), current.Version).AsTask());
        Assert.AreSame(current, editor.Current);
        plan = await new SolEncodingConversion(codec).AnalyzeAsync(current.Document!, SolEncoding.Amf0);
        await editor.ApplyAsync(new ApplySolConversion(plan), editor.Current.Version); Assert.AreEqual(SolEncoding.Amf0, editor.Current.Document!.Encoding);
        await editor.UndoAsync(editor.Current.Version); Assert.AreEqual(SolEncoding.Amf3, editor.Current.Document!.Encoding);
    }

    [TestMethod]
    public async Task SharedDisposeCancelsPendingCodecWorkAndRejectsNewEdits()
    {
        using var directory = new TemporaryDirectory(); using var codec = new BlockingCodec();
        var editor = SolEditorSession.Create(codec, new SolFileStorage(), "pending", SolEncoding.Amf3);
        var save = editor.SaveAsAsync(directory.GetPath("never.sol"), editor.Current.Version).AsTask(); await codec.Started.Task.WaitAsync(TimeSpan.FromSeconds(3));
        var first = editor.DisposeAsync().AsTask(); var second = editor.DisposeAsync().AsTask(); Assert.AreSame(first, second);
        await first.WaitAsync(TimeSpan.FromSeconds(3)); await Assert.ThrowsAsync<OperationCanceledException>(() => save);
        await Assert.ThrowsExactlyAsync<ObjectDisposedException>(() => editor.ApplyAsync(new RenameSolDocument("late"), 0).AsTask());
        Assert.IsFalse(File.Exists(directory.GetPath("never.sol")));
    }

    private static string Hash(byte[] bytes) => Convert.ToHexStringLower(SHA256.HashData(bytes));
    private static byte[] Unsupported(string kind)
    {
        if (kind == "damaged") return [0x00, 0xff];
        var encoding = kind == "external" ? SolEncoding.Amf3 : SolEncoding.Amf0;
        var header = new SolCodec().Encode(new("", encoding, new AmfGraph([])));
        var body = Convert.FromHexString(kind == "external" ? "03780a071f756e6b6e6f776e2e5061796c6f6164deadbeef00" : "000178ff00");
        var result = header.Concat(body).ToArray(); BinaryPrimitives.WriteUInt32BigEndian(result.AsSpan(2, 4), (uint)(result.Length - 6)); return result;
    }
    private sealed class CancelAfterCommitStorage(CancellationTokenSource cancellation) : ISolFileStorage
    {
        private readonly SolFileStorage _inner = new();
        public ValueTask<SolFileImage> ReadAsync(string path, int maximumBytes, CancellationToken cancellationToken = default) => _inner.ReadAsync(path, maximumBytes, cancellationToken);
        public async ValueTask<SolFileRevision> CommitAsync(string path, ReadOnlyMemory<byte> bytes, SolFileRevision expectedRevision, bool createBackup = true, CancellationToken cancellationToken = default)
        { var result = await _inner.CommitAsync(path, bytes, expectedRevision, createBackup, cancellationToken); cancellation.Cancel(); return result; }
    }
    private sealed class BlockingCodec : ISolCodec, IDisposable
    {
        private readonly ManualResetEventSlim _release = new();
        public TaskCompletionSource Started { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
        public SolDocument Decode(ReadOnlyMemory<byte> source, AmfLimits? limits = null, CancellationToken cancellationToken = default) => new SolCodec().Decode(source, limits, cancellationToken);
        public byte[] Encode(SolDocument document, AmfLimits? limits = null, CancellationToken cancellationToken = default)
        { Started.TrySetResult(); _release.Wait(cancellationToken); return new SolCodec().Encode(document, limits, cancellationToken); }
        public void Dispose() { _release.Set(); _release.Dispose(); }
    }
