    [TestMethod]
    [DataRow((int)AtomicWriteStage.TemporaryCreated, false)]
    [DataRow((int)AtomicWriteStage.ContentFlushed, false)]
    [DataRow((int)AtomicWriteStage.BeforeCommit, false)]
    [DataRow((int)AtomicWriteStage.TemporaryCreated, true)]
    [DataRow((int)AtomicWriteStage.ContentFlushed, true)]
    [DataRow((int)AtomicWriteStage.BeforeCommit, true)]
    public async Task WriteFailureOrCancellationNeverPublishesASavedState(int stage, bool cancel)
    {
        using var directory = new TemporaryDirectory(); var path = directory.GetPath("atomic.sol"); File.Copy(TestAssets.Sol("mao.sol"), path);
        var bytes = await File.ReadAllBytesAsync(path); using var cancellation = new CancellationTokenSource(); var enabled = true;
        var storage = new SolFileStorage((actual, token) =>
        {
            if (enabled && actual == (AtomicWriteStage)stage) { if (cancel) cancellation.Cancel(); else throw new IOException("Synthetic SOL disk failure"); }
            return ValueTask.CompletedTask;
        });
        await using var editor = await SolEditorSession.OpenAsync(new SolCodec(), storage, path);
        await editor.ApplyAsync(new ReplaceSolEntry(0, "level", new AmfInteger(100)), editor.Current.Version); var draft = editor.Current;
        if (cancel) await Assert.ThrowsAsync<OperationCanceledException>(() => editor.SaveAsync(draft.Version, cancellation.Token).AsTask());
        else await Assert.ThrowsExactlyAsync<IOException>(() => editor.SaveAsync(draft.Version).AsTask());
        Assert.AreSame(draft, editor.Current); CollectionAssert.AreEqual(bytes, await File.ReadAllBytesAsync(path)); Assert.IsFalse(File.Exists(path + ".bak"));
        Assert.HasCount(0, Directory.GetFiles(directory.RootPath, "*.tmp"));
        enabled = false; await editor.SaveAsync(editor.Current.Version); Assert.IsFalse(editor.Current.IsDirty);
        CollectionAssert.AreEqual(bytes, await File.ReadAllBytesAsync(path + ".bak"));
    }

    [TestMethod]
    public async Task CancellationAfterTheDiskCommitStillPublishesTheCommittedRevision()
