    }

    [TestMethod]
    public void NavigationPolicyAndUnavailableSettingsAreExplicit()
    {
        Assert.AreEqual("https://www.bing.com/search?q=mole.61.com", SettingsService.ResolveAddress("mole.61.com", AppSettings.Default with { NavigationType = NavigationType.SearchOnly }).AbsoluteUri);
        Assert.AreEqual("http://mole.61.com/", SettingsService.ResolveAddress("mole.61.com", AppSettings.Default with { NavigationType = NavigationType.NavigateOnly }).AbsoluteUri);
        Assert.IsTrue(SettingsCapabilities.Current.Any(x => x.Field == "ProxySettings" && x.Availability == SettingAvailability.UnsupportedOnMacOS));
        Assert.IsTrue(SettingsCapabilities.Current.Any(x => x.Field == "FakeFlashVersionSetting" && x.Availability == SettingAvailability.UnsupportedOnMacOS));
        Assert.IsTrue(SettingsCapabilities.Current.Any(x => x.Field == "UserAgentSetting" && x.Availability == SettingAvailability.StoredPendingIntegration));
    }

    [TestMethod]
    public async Task NonFiniteLegacyWindowCoordinatesNormalizeButRawValuesRemain()
    {
        using var directory = new TemporaryDirectory();
        var path = directory.GetPath("settings.json");
        await File.WriteAllTextAsync(path, "{\"MainWindowSizeInfo\":{\"Left\":\"NaN\",\"Top\":\"Infinity\",\"Width\":800,\"Height\":600}}");
        using var repository = new JsonSettingsRepository(path);
        var settings = await repository.LoadAsync();
        Assert.IsNull(settings.Value.MainWindowSizeInfo!.Left);
        Assert.IsNull(settings.Value.MainWindowSizeInfo.Top);
        await repository.UpgradeAsync();
        var raw = System.Text.Json.Nodes.JsonNode.Parse(await File.ReadAllTextAsync(path))!;
        Assert.AreEqual("NaN", raw["legacy"]!["sourceSettings"]!["MainWindowSizeInfo"]!["Left"]!.GetValue<string>());
    }

    [TestMethod]
    public void RemainingLegacyAddressClassificationCasesStillMatch()
    {
        Assert.IsFalse(NavigationResolver.LooksLikeWebAddress(null));
        Assert.IsFalse(NavigationResolver.LooksLikeWebAddress(""));
        Assert.IsFalse(NavigationResolver.LooksLikeWebAddress("   "));
        Assert.IsTrue(NavigationResolver.LooksLikeWebAddress("localhost"));
        Assert.IsTrue(NavigationResolver.LooksLikeWebAddress("192.168.1.1"));
        Assert.IsTrue(NavigationResolver.LooksLikeWebAddress("example.com"));
        Assert.IsTrue(NavigationResolver.LooksLikeWebAddress("www.example.com"));
        Assert.IsTrue(NavigationResolver.LooksLikeWebAddress("https://example.com"));
        Assert.IsTrue(NavigationResolver.LooksLikeWebAddress("example.com/path/to/page"));
        Assert.IsTrue(NavigationResolver.LooksLikeWebAddress("example.com?q=test"));
    }
