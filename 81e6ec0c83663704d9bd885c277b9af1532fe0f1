''')
write('tests/FlashMacOS.Sol.Managed.Tests/GlobalUsings.cs','global using FlashMacOS.Domain.Sol;\n')
write('tests/FlashMacOS.Domain.Tests/ArchitectureTests.cs','''using FlashMacOS.Domain.Browser;

namespace FlashMacOS.Tests;

[TestClass]
public sealed class DomainArchitectureTests
{
    [TestMethod]
    public void DomainReferencesOnlyBaseClassLibraries()
    {
        var forbidden = typeof(BrowserState).Assembly.GetReferencedAssemblies()
            .Where(reference => !reference.Name!.StartsWith("System.", StringComparison.Ordinal)
                && reference.Name != "System" && reference.Name != "netstandard" && reference.Name != "mscorlib")
            .Select(reference => reference.Name).ToArray();
        Assert.IsEmpty(forbidden, string.Join(", ", forbidden));
    }
}
''')
write('tests/FlashMacOS.Application.Tests/ArchitectureTests.cs','''using FlashMacOS.Application.Flash;

namespace FlashMacOS.Tests;

[TestClass]
public sealed class ApplicationArchitectureTests
{
    [TestMethod]
    public void ApplicationDependsOnlyOnDomainAndBaseClassLibraries()
    {
        var forbidden = typeof(RufflePlayerCoordinator).Assembly.GetReferencedAssemblies()
            .Where(reference => reference.Name != "FlashMacOS.Domain"
                && !reference.Name!.StartsWith("System.", StringComparison.Ordinal)
                && reference.Name != "System" && reference.Name != "netstandard" && reference.Name != "mscorlib")
            .Select(reference => reference.Name).ToArray();
        Assert.IsEmpty(forbidden, string.Join(", ", forbidden));
    }
