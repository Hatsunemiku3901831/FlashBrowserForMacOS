import argparse
from contextlib import redirect_stdout
import importlib.util
import io
import json
from pathlib import Path
import subprocess
import tempfile
import unittest

spec = importlib.util.spec_from_file_location('import_source', Path(__file__).resolve().parents[2] / 'scripts/import-source.py')
import_source = importlib.util.module_from_spec(spec)
spec.loader.exec_module(import_source)


class ImportSourceTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        root = Path(self.temp.name)
        self.source, self.target = root / 'source', root / 'target'
        self.source.mkdir()
        self.target.mkdir()
        subprocess.run(['git', 'init', '-q', str(self.source)], check=True)
        subprocess.run(['git', '-C', str(self.source), '-c', 'user.name=Fixture', '-c',
                        'user.email=fixture@example.invalid', 'commit', '--allow-empty', '-qm', 'fixture'], check=True)
        subprocess.run(['git', '-C', str(self.source), 'remote', 'add', 'origin', 'https://example.invalid/source'], check=True)
        (self.source / 'spike').mkdir()
        (self.source / 'spike/带 空格.swf').write_bytes(b'fixed SWF fixture')
        (self.source / 'spike/run.sh').write_bytes(b'#!/bin/sh\n')
        (self.source / 'spike/run.sh').chmod(0o755)
        (self.source / 'spike/bin').mkdir()
        (self.source / 'spike/bin/ignored').write_bytes(b'generated')
        self.baseline = self.target / 'baseline.json'
        self.baseline.write_text(json.dumps({'files': [], 'sourceRoots': ['spike'],
             'sourceHead': import_source.git(self.source, 'rev-parse', 'HEAD').decode().strip(),
             'excludedDirectoryNames': ['bin'], 'excludedFileNames': []}))
        self.args = argparse.Namespace(source=self.source, target=self.target,
                      baseline=self.baseline, apply=False, report=None)

    def run_import(self):
        with redirect_stdout(io.StringIO()):
            return import_source.run(self.args)

    def test_dry_run_no_writes_then_repeat_is_byte_and_mtime_noop(self):
        self.assertEqual(0, self.run_import())
        self.assertFalse((self.target / 'reference').exists())
        self.args.apply = True
        self.assertEqual(0, self.run_import())
        before = {p.relative_to(self.target): (p.read_bytes(), p.stat().st_mtime_ns)
                  for p in self.target.rglob('*') if p.is_file()}
        self.assertEqual(0, self.run_import())
        after = {p.relative_to(self.target): (p.read_bytes(), p.stat().st_mtime_ns)
                 for p in self.target.rglob('*') if p.is_file()}
        self.assertEqual(before, after)
        self.assertFalse((self.target / 'reference/legacy/spike/bin').exists())
        self.assertTrue((self.target / 'reference/legacy/spike/run.sh').stat().st_mode & 0o111)

    def test_conflict_preflight_preserves_existing_file_and_copies_nothing(self):
        conflict = self.target / 'reference/legacy/spike/run.sh'
        conflict.parent.mkdir(parents=True)
        conflict.write_bytes(b'user change')
        self.args.apply = True
        self.assertEqual(1, self.run_import())
        self.assertEqual(b'user change', conflict.read_bytes())
        self.assertFalse((conflict.parent / '带 空格.swf').exists())

    def test_source_symlink_excluded_and_destination_symlink_rejected(self):
        (self.source / 'spike/link').symlink_to(self.baseline)
        self.args.apply = True
        self.assertEqual(0, self.run_import())
        self.assertFalse((self.target / 'reference/legacy/spike/link').exists())
        (self.target / 'reference/legacy/spike/link').symlink_to(self.baseline)
        (self.source / 'spike/link').unlink()
        (self.source / 'spike/link').write_bytes(b'new input')
        with self.assertRaisesRegex(ValueError, 'symlink'):
            self.run_import()

    def test_nested_roots_and_escaping_roots_rejected(self):
        self.args.target = self.source / 'spike'
        with self.assertRaisesRegex(ValueError, 'non-nested'):
            self.run_import()
        self.args.target = self.target
        p = json.loads(self.baseline.read_text())
        p['sourceRoots'] = ['../target']
        self.baseline.write_text(json.dumps(p))
        with self.assertRaisesRegex(ValueError, 'relative path'):
            self.run_import()

    def test_changed_source_rejected_after_freeze(self):
        self.args.apply = True
        self.assertEqual(0, self.run_import())
        (self.source / 'spike/run.sh').write_bytes(b'changed source')
        self.assertEqual(1, self.run_import())
        self.assertEqual(b'#!/bin/sh\n', (self.target / 'reference/legacy/spike/run.sh').read_bytes())


if __name__ == '__main__':
    unittest.main()
