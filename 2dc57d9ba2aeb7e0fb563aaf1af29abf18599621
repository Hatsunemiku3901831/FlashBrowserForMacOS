#!/usr/bin/env python3
"""Create the initial formal foundation from the accepted P03 copy; never overwrites a different file."""
from pathlib import Path
import hashlib
import json

ROOT=Path(__file__).resolve().parents[1]
BOOT=ROOT/'bootstrap/legacy/spike/macos-host'
entries=[]

def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def write(relative,content,source=None,reason='A01 project-authored formal boundary'):
    p=ROOT/relative
    data=content.encode() if isinstance(content,str) else content
    if p.exists() and p.read_bytes()!=data:raise ValueError('Preserving conflicting file: '+str(p))
    p.parent.mkdir(parents=True,exist_ok=True)
    if not p.exists():
        with p.open('xb') as stream:stream.write(data)
    original=None
    if source and source.is_relative_to(BOOT):
        original=ROOT/'reference/legacy/spike/macos-host'/source.relative_to(BOOT)
    entries.append({'bootstrapSourcePath':str(source.relative_to(ROOT)) if source else None,'bootstrapSourceSha256':sha(source) if source else None,
        'originalSourcePath':str(original.relative_to(ROOT/'reference/legacy')) if original and original.is_file() else None,
        'originalSourceSha256':sha(original) if original and original.is_file() else None,
        'targetPath':relative,'targetSha256':sha(p),'reason':reason})

def copy(relative,source,transforms=()):
    data=source.read_bytes()
    if transforms:
        value=data.decode()
        for a,b in transforms:value=value.replace(a,b)
        data=value.encode()
    write(relative,data,source,'A01 relocate accepted code/asset; preserve behavior, namespace and boundary adaptation only')

for name in ('global.json','Directory.Build.props','Directory.Packages.props'):copy(name,BOOT/name)
copy('LICENSE',ROOT/'reference/legacy/LICENSE')
write('Directory.Build.targets','''<Project>
  <Target Name="ValidateFlashMacOSArchitecture" BeforeTargets="Restore;PrepareForBuild;Publish"
