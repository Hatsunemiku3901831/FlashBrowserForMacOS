  </Target>
</Project>
''')
for name,refs in [('Domain',[]),('Application',['Domain']),('Sol.Managed',['Domain','Application'])]:
    items='\n'.join(f'    <ProjectReference Include="../FlashMacOS.{r}/FlashMacOS.{r}.csproj" />' for r in refs)
    write(f'src/FlashMacOS.{name}/FlashMacOS.{name}.csproj','<Project Sdk="Microsoft.NET.Sdk">\n  <ItemGroup>\n'+items+'\n  </ItemGroup>\n</Project>\n')
    if name!='Domain':write(f'src/FlashMacOS.{name}/GlobalUsings.cs','global using FlashMacOS.Domain.Browser;\nglobal using FlashMacOS.Domain.Flash;\nglobal using FlashMacOS.Domain.Sol;\n')
