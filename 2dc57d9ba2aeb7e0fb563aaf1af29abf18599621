s=(core/'Application/Browser/BrowserContracts.cs').read_text();models,interface=s.split('public interface IBrowserSession',1)
write('src/FlashMacOS.Domain/Browser/BrowserModels.cs',models.replace('CefFlashBrowser.MacOS.Spike.Core.Application.Browser','FlashMacOS.Domain.Browser'),core/'Application/Browser/BrowserContracts.cs','A01 split pure browser models into Domain; no UI or file-system implementation')
write('src/FlashMacOS.Application/Browser/IBrowserSession.cs','namespace FlashMacOS.Application.Browser;\n\npublic interface IBrowserSession'+interface,core/'Application/Browser/BrowserContracts.cs','A01 move browser port to Application; models owned by Domain')
s=(core/'Flash/Hosting/LocalContentContracts.cs').read_text();models,interface=s.split('public interface ILocalContentHost',1)
write('src/FlashMacOS.Domain/Flash/LocalSwfSource.cs',models.replace('CefFlashBrowser.MacOS.Spike.Core.Flash.Hosting','FlashMacOS.Domain.Flash'),core/'Flash/Hosting/LocalContentContracts.cs','A01 pure source model')
interface=interface.replace('    Uri? BaseUri { get; }','    string RuntimeVersion { get; }\n\n    Uri? BaseUri { get; }')
write('src/FlashMacOS.Application/Flash/ILocalContentHost.cs','namespace FlashMacOS.Application.Flash;\n\npublic interface ILocalContentHost'+interface,core/'Flash/Hosting/LocalContentContracts.cs','A01 host port plus runtime metadata; no concrete Ruffle dependency in use cases')
s=(core/'Sol/SolFileHeader.cs').read_text();models=s[s.index('public enum SolEncoding'):s.index('public static class SolFileInspector')]
write('src/FlashMacOS.Domain/Sol/SolFileHeader.cs','namespace FlashMacOS.Domain.Sol;\n\n'+models,core/'Sol/SolFileHeader.cs','A01 pure SOL metadata; full AMF graph remains S01')
implementation=s[:s.index('public enum SolEncoding')]+s[s.index('public static class SolFileInspector'):]
write('src/FlashMacOS.Sol.Managed/SolFileInspector.cs',implementation.replace('CefFlashBrowser.MacOS.Spike.Core.Sol','FlashMacOS.Sol.Managed'),core/'Sol/SolFileHeader.cs','A01 retain bounded header inspector in codec adapter; no full codec claim')
