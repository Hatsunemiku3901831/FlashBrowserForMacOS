#!/usr/bin/env python3
"""Optionally rebuild project-authored P02 fixtures into a fresh review directory.

Normal builds use the checked-in SWFs/MP3. This tool never replaces them or
changes their manifest. Supply a separately obtained Apache Flex 4.16.1 SDK,
the frozen playerglobal API definitions, Java and ffmpeg.
"""
import argparse
import hashlib
import json
import math
from pathlib import Path
import shutil
import struct
import subprocess
import wave


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--sdk', required=True, type=Path)
    parser.add_argument('--playerglobal', required=True, type=Path)
    parser.add_argument('--output-dir', required=True, type=Path)
    args = parser.parse_args()
    root = Path(__file__).resolve().parents[1]
    source = root / 'test-assets/flash/p02-project'
    manifest = json.loads((source / 'manifest.json').read_text())
    sdk = args.sdk.resolve(strict=True)
    api = args.playerglobal.resolve(strict=True)
    compiler = sdk / 'lib/mxmlc.jar'
    if not compiler.is_file() or not (sdk / 'frameworks').is_dir():
        parser.error('Expected an extracted Apache Flex SDK with lib/mxmlc.jar and frameworks')
    if sha(api) != manifest['compiler']['playerglobalSha256']:
        parser.error('playerglobal does not match the frozen API hash')
    java, ffmpeg = shutil.which('java'), shutil.which('ffmpeg')
    if java is None or ffmpeg is None:
        parser.error('Java and ffmpeg must be available for optional asset regeneration')
    output = args.output_dir.resolve()
    output.mkdir(parents=True, exist_ok=False)
    commands = []
    for fixture, class_name in [('project-network', 'NetworkProbe'), ('project-audio', 'AudioProbe')]:
        destination = output / fixture
        destination.mkdir()
        command = [java, '-jar', str(compiler), '+flexlib=' + str(sdk / 'frameworks'),
                   '-load-config=', '-compiler.theme=', '-compiler.external-library-path=' + str(api),
                   '-target-player=11.1', '-swf-version=14', '-debug=false', '-compiler.omit-trace-statements=false',
                   '-output=' + str(destination / 'test.swf'), str(source / fixture / (class_name + '.as'))]
        with (destination / 'compiler.log').open('wb') as log:
            code = subprocess.run(command, cwd=root, stdout=log, stderr=subprocess.STDOUT).returncode
        commands.append({'command': command, 'exitCode': code})
        if code:
            (output / 'commands.json').write_text(json.dumps(commands, indent=2) + '\n')
            return code
    audio = output / 'project-audio'
    with wave.open(str(audio / 'tone.wav'), 'wb') as stream:
        stream.setparams((1, 2, 44100, 0, 'NONE', 'not compressed'))
        stream.writeframes(b''.join(struct.pack('<h', round(32767 * 0.2 * math.sin(2 * math.pi * 440 * n / 44100)))
                                    for n in range(44100 * 3)))
    command = [ffmpeg, '-nostdin', '-i', str(audio / 'tone.wav'), '-map_metadata', '-1',
               '-codec:a', 'libmp3lame', '-b:a', '128k', str(audio / 'tone.mp3')]
    with (audio / 'encoder.log').open('wb') as log:
        subprocess.run(command, stdout=log, stderr=subprocess.STDOUT, check=True)
    commands.append({'command': command, 'exitCode': 0})
    files = []
    for path in sorted(output.rglob('*')):
        if path.is_file() and path.suffix in ('.swf', '.mp3', '.wav'):
            relative = path.relative_to(output)
            files.append({'path': str(relative), 'sha256': sha(path), 'frozenSha256': sha(source / relative),
                          'byteIdentical': sha(path) == sha(source / relative)})
    report = {'kind': 'optional-regeneration-only', 'compilerSha256': sha(compiler),
              'playerglobalSha256': sha(api), 'commands': commands, 'files': files,
              'note': 'Review differences before any explicit asset replacement. Frozen source and manifest were not changed.'}
    (output / 'result.json').write_text(json.dumps(report, indent=2) + '\n')
    print(json.dumps({'output': str(output), 'files': files}, indent=2))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
