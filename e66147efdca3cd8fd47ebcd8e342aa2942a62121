public sealed class AmfVectorObjectNode : AmfNode
{
    public AmfVectorObjectNode(AmfNodeId id, IEnumerable<AmfValue> values, bool isFixed, string typeName = "*") : base(id)
    { Values = AmfCollections.Freeze(values); IsFixed = isFixed; TypeName = typeName ?? throw new ArgumentNullException(nameof(typeName)); }
    public IReadOnlyList<AmfValue> Values { get; }
    public bool IsFixed { get; }
    public string TypeName { get; }
    public override AmfNodeKind Kind => AmfNodeKind.VectorObject;
    public override IEnumerable<AmfValue> Children => Values;
}
public sealed class AmfDictionaryNode(AmfNodeId id, IEnumerable<AmfDictionaryEntry> entries, bool weakKeys) : AmfNode(id)
{
    public IReadOnlyList<AmfDictionaryEntry> Entries { get; } = AmfCollections.Freeze(entries);
    public bool WeakKeys { get; } = weakKeys;
    public override AmfNodeKind Kind => AmfNodeKind.Dictionary;
    public override IEnumerable<AmfValue> Children => Entries.SelectMany(entry => new[] { entry.Key, entry.Value });
}
