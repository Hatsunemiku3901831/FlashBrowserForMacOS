    private bool IsAuthorizedContentRequest(HttpContext context)
    {
        if (context.Request.Query.TryGetValue("session", out var queryToken)
            && TokenMatches(queryToken.ToString()))
        {
            return true;
        }

        return context.Request.Cookies.TryGetValue(SessionCookieName, out var cookieToken)
            && TokenMatches(cookieToken);
    }

    private bool TokenMatches(string candidate)
    {
        if (candidate.Length != _sessionToken.Length)
        {
            return false;
        }

        return CryptographicOperations.FixedTimeEquals(
            Encoding.ASCII.GetBytes(candidate),
            Encoding.ASCII.GetBytes(_sessionToken));
    }

    private static bool IsLoopbackRequest(HttpContext context)
    {
        var localAddress = context.Connection.LocalIpAddress;
        var remoteAddress = context.Connection.RemoteIpAddress;
        var host = context.Request.Host.Host;
        return localAddress is not null
            && remoteAddress is not null
            && IPAddress.IsLoopback(localAddress)
            && IPAddress.IsLoopback(remoteAddress)
            && (host.Equals("127.0.0.1", StringComparison.OrdinalIgnoreCase)
                || host.Equals("localhost", StringComparison.OrdinalIgnoreCase)
                || host.Equals("[::1]", StringComparison.OrdinalIgnoreCase));
    }

    private void SetSessionCookie(HttpResponse response)
    {
        response.Cookies.Append(SessionCookieName, _sessionToken, new CookieOptions
        {
            HttpOnly = true,
            IsEssential = true,
            SameSite = Microsoft.AspNetCore.Http.SameSiteMode.Strict,
            Path = "/",
        });
    }

    private static void AddCrossOriginAssetHeaders(HttpResponse response)
    {
        response.Headers[HeaderNames.AccessControlAllowOrigin] = "*";
        response.Headers["Cross-Origin-Resource-Policy"] = "cross-origin";
        response.Headers[HeaderNames.CacheControl] = "public, max-age=31536000, immutable";
    }

    private static void AddHtmlSecurityHeaders(HttpResponse response)
    {
        response.Headers[HeaderNames.CacheControl] = "no-store";
        response.Headers[HeaderNames.ContentSecurityPolicy] =
            "default-src 'self' data: blob:; " +
            "script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; " +
            "style-src 'self' 'unsafe-inline'; object-src 'self'; frame-src 'self'; worker-src 'self' blob:;";
    }

    private static string GetContentType(string path)
    {
        return Path.GetExtension(path).ToLowerInvariant() switch
        {
            ".wasm" => "application/wasm",
            ".js" => "text/javascript; charset=utf-8",
            ".json" => "application/json; charset=utf-8",
            ".html" or ".htm" => "text/html; charset=utf-8",
            ".css" => "text/css; charset=utf-8",
            ".swf" => "application/x-shockwave-flash",
            ".sol" => "application/octet-stream",
            ".xml" => "application/xml; charset=utf-8",
            ".txt" => "text/plain; charset=utf-8",
            ".png" => "image/png",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".gif" => "image/gif",
            ".svg" => "image/svg+xml",
            ".mp3" => "audio/mpeg",
            ".wav" => "audio/wav",
            ".flv" => "video/x-flv",
            _ => "application/octet-stream",
        };
    }

