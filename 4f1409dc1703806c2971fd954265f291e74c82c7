namespace FlashMacOS.Flash.Ruffle.Hosting;

public sealed class LoopbackContentHost : ILocalContentHost
{
    private const string SessionCookieName = "CefFlashBrowser-Loopback-Session";
    private const string GateZeroCookieName = "CefFlashBrowser-Gate0";
    private const string ExternalInterfaceSwfFileName = "test.swf";

    private static readonly string[] ExternalInterfaceFixtureFiles =
        ["Test.as", "index.html", "test.fla", ExternalInterfaceSwfFileName, "test.ts"];

    private static readonly JsonSerializerOptions HtmlJsonOptions = new(JsonSerializerDefaults.Web)
    {
        Encoder = JavaScriptEncoder.Default,
    };

    private readonly string _ruffleAssetDirectory;
    private readonly string? _solFixturePath;
    private readonly string? _externalInterfaceFixtureDirectory;
    private readonly IRuffleSaveStore _saveStore;
    private readonly ConcurrentDictionary<string, Registration> _registrations = new(StringComparer.Ordinal);
    private readonly SemaphoreSlim _lifecycleGate = new(1, 1);
    private readonly string _sessionToken = Convert.ToHexStringLower(RandomNumberGenerator.GetBytes(32));
    private WebApplication? _application;
    private bool _disposed;

    public LoopbackContentHost(string ruffleAssetDirectory, string solFixturePath, string externalInterfaceFixtureDirectory, IRuffleSaveStore saveStore)
        : this(ruffleAssetDirectory, saveStore)
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(solFixturePath);
        ArgumentException.ThrowIfNullOrWhiteSpace(externalInterfaceFixtureDirectory);
        _solFixturePath = Path.GetFullPath(solFixturePath);
        _externalInterfaceFixtureDirectory = Path.GetFullPath(externalInterfaceFixtureDirectory);
    }

    // Ordinary product startup needs only the pinned runtime and the user's save store.
    public LoopbackContentHost(string ruffleAssetDirectory, IRuffleSaveStore saveStore)
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(ruffleAssetDirectory);
        ArgumentNullException.ThrowIfNull(saveStore);
        _ruffleAssetDirectory = Path.GetFullPath(ruffleAssetDirectory);
        _saveStore = saveStore;
    }

    public string RuntimeVersion => RuffleAssetManifest.Version;

    public Uri? BaseUri { get; private set; }

    public Uri? HomeUri => BaseUri is null ? null : new Uri(BaseUri, $"{_sessionToken}/home");

    public Uri? DiagnosticsUri => BaseUri is null || _solFixturePath is null
        ? null
        : new Uri(BaseUri, $"{_sessionToken}/diagnostics");

    public Uri? RufflePublicPath => BaseUri is null
        ? null
        : new Uri(BaseUri, $"{_sessionToken}/assets/ruffle/");

    public async ValueTask StartAsync(CancellationToken cancellationToken = default)
    {
        await _lifecycleGate.WaitAsync(cancellationToken).ConfigureAwait(false);
        try
        {
            ThrowIfDisposed();
            await StartCoreAsync(cancellationToken).ConfigureAwait(false);
        }
        finally
        {
            _lifecycleGate.Release();
        }
    }

    public async ValueTask<LocalSwfSource> RegisterSwfAsync(
        string filePath,
        CancellationToken cancellationToken = default)
    {
        return await RegisterSwfAsync(filePath, RuffleGameConfiguration.Default, cancellationToken).ConfigureAwait(false);
    }

    public async ValueTask<LocalSwfSource> RegisterSwfAsync(string filePath, RuffleGameConfiguration configuration,
        CancellationToken cancellationToken = default)
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(filePath);
        ArgumentNullException.ThrowIfNull(configuration);
        configuration.Validate();
        await _lifecycleGate.WaitAsync(cancellationToken).ConfigureAwait(false);
        try
        {
            ThrowIfDisposed();
            await StartCoreAsync(cancellationToken).ConfigureAwait(false);

            var fullPath = Path.GetFullPath(filePath);
            if (!File.Exists(fullPath))
            {
                throw new FileNotFoundException("The selected SWF file does not exist.", fullPath);
            }

            if (!Path.GetExtension(fullPath).Equals(".swf", StringComparison.OrdinalIgnoreCase))
            {
                throw new InvalidDataException("Only .swf files can be registered with the local player.");
            }

            var pathHash = SHA256.HashData(Encoding.UTF8.GetBytes(fullPath));
            var id = Convert.ToHexStringLower(pathHash.AsSpan(0, 16));
            var root = Path.GetDirectoryName(fullPath)
                ?? throw new InvalidOperationException("The SWF parent directory could not be resolved.");
            var fileName = Path.GetFileName(fullPath);
            var registration = new Registration(id, root, fileName, fullPath, configuration);
            _registrations[id] = registration;

            var escapedFileName = Uri.EscapeDataString(fileName);
            var swfUri = new Uri(BaseUri!, $"content/{id}/{escapedFileName}?session={_sessionToken}");
            var playerUri = new Uri(BaseUri!, $"{_sessionToken}/player/{id}");
            var storagePrefix = $"127.0.0.1{swfUri.AbsolutePath}";
            return new LocalSwfSource(id, fullPath, playerUri, swfUri, storagePrefix);
        }
        finally
        {
            _lifecycleGate.Release();
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _lifecycleGate.WaitAsync().ConfigureAwait(false);
        try
        {
            if (_disposed)
            {
                return;
            }

            _disposed = true;
            var application = _application;
            if (application is null)
            {
                ClearRuntimeState();
                return;
            }

            try
            {
                using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(3));
                await application.StopAsync(timeout.Token).ConfigureAwait(false);
            }
            finally
            {
                try
                {
                    await application.DisposeAsync().ConfigureAwait(false);
                }
                finally
                {
                    ClearRuntimeState();
                }
            }
        }
        finally
        {
            _lifecycleGate.Release();
            // No caller accesses AvailableWaitHandle, so retaining this gate does not retain an
            // independent native handle. Disposing it would race concurrent lifecycle waiters.
        }
    }

    private async ValueTask StartCoreAsync(CancellationToken cancellationToken)
    {
        if (_application is not null)
        {
            return;
        }

        await RuffleAssetManifest.ValidateAsync(_ruffleAssetDirectory, cancellationToken)
            .ConfigureAwait(false);
        if (_solFixturePath is not null && !File.Exists(_solFixturePath))
        {
            throw new FileNotFoundException("The Gate 0 SOL fixture is missing.", _solFixturePath);
        }

        foreach (var fileName in _externalInterfaceFixtureDirectory is null ? [] : ExternalInterfaceFixtureFiles)
        {
            var fixturePath = Path.Combine(_externalInterfaceFixtureDirectory!, fileName);
            if (!File.Exists(fixturePath))
            {
                throw new FileNotFoundException(
                    "The pinned ExternalInterface fixture is missing.",
                    fixturePath);
            }
        }

        var builder = WebApplication.CreateSlimBuilder(new WebApplicationOptions
        {
            ApplicationName = typeof(LoopbackContentHost).Assembly.FullName,
            ContentRootPath = AppContext.BaseDirectory,
        });
        builder.Logging.ClearProviders();
        builder.WebHost.ConfigureKestrel(options =>
        {
            options.Listen(IPAddress.Loopback, 0, listen => listen.Protocols = HttpProtocols.Http1);
            options.AddServerHeader = false;
        });

        var application = builder.Build();
        try
        {
            MapRoutes(application);
            await application.StartAsync(cancellationToken).ConfigureAwait(false);

            var addresses = application.Services
                .GetRequiredService<IServer>()
                .Features
                .Get<IServerAddressesFeature>()
                ?.Addresses;
            var address = addresses?.SingleOrDefault()
                ?? throw new InvalidOperationException("Kestrel did not publish a loopback address.");
            BaseUri = new Uri(address.EndsWith('/') ? address : address + '/', UriKind.Absolute);
            _application = application;
        }
        catch
        {
            await application.DisposeAsync().ConfigureAwait(false);
            throw;
        }
    }

    private void ClearRuntimeState()
    {
        _application = null;
        BaseUri = null;
        _registrations.Clear();
    }

    private void ThrowIfDisposed()
    {
        ObjectDisposedException.ThrowIf(_disposed, this);
    }

    private void MapRoutes(WebApplication app)
    {
        app.Use(async (context, next) =>
        {
            if (!IsLoopbackRequest(context))
            {
                context.Response.StatusCode = StatusCodes.Status404NotFound;
                return;
            }

            context.Response.Headers[HeaderNames.XContentTypeOptions] = "nosniff";
            context.Response.Headers["Referrer-Policy"] = "no-referrer";
            await next(context).ConfigureAwait(false);
        });

        app.MapGet($"/{_sessionToken}/health", () => Results.Json(new
        {
            status = "ok",
            ruffleVersion = RuffleAssetManifest.Version,
        }));

        app.MapGet($"/{_sessionToken}/assets/ruffle/{{fileName}}", (string fileName, HttpContext context) =>
        {
            if (!RuffleAssetManifest.RuntimeFiles.ContainsKey(fileName))
            {
                return Results.NotFound();
            }

            AddCrossOriginAssetHeaders(context.Response);
            var path = Path.Combine(_ruffleAssetDirectory, fileName);
            return Results.File(
                path,
                GetContentType(path),
                enableRangeProcessing: true,
                lastModified: File.GetLastWriteTimeUtc(path));
        });

        app.MapGet($"/{_sessionToken}/player/{{id}}", async (string id, HttpContext context) =>
        {
            if (!_registrations.TryGetValue(id, out var registration))
            {
                return Results.NotFound();
            }

            SetSessionCookie(context.Response);
            AddHtmlSecurityHeaders(context.Response);
            var saves = await _saveStore.GetAllAsync(context.RequestAborted).ConfigureAwait(false);
            return Results.Content(BuildPlayerPage(registration, saves), "text/html; charset=utf-8");
        });

        app.MapGet($"/{_sessionToken}/home", (HttpContext context) =>
        {
            AddHtmlSecurityHeaders(context.Response);
            return Results.Content("<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><title>FlashMacOS</title>" +
                "<style>body{font:18px system-ui;padding:48px;color:#202838;background:#f5f7fb}p{max-width:620px}</style>" +
                "<h1>FlashMacOS</h1><p>Open a local SWF with Open SWF, or enter a website address above.</p>" +
                "<p>Bundled Ruffle 0.4.1 runs offline. Flash compatibility varies by game; synchronous re-entry and some Flash security APIs are unsupported.</p></html>", "text/html; charset=utf-8");
        });
        if (_solFixturePath is not null) MapDiagnostics(app);

        app.MapGet("/content/{id}/{**relativePath}", (string id, string relativePath, HttpContext context) =>
        {
            if (!IsAuthorizedContentRequest(context)
                || !_registrations.TryGetValue(id, out var registration))
            {
                return Results.NotFound();
            }

            var path = PathSafety.ResolveRegularFile(registration.RootDirectory, relativePath);
            if (path is null)
            {
                return Results.NotFound();
            }

            context.Response.Headers[HeaderNames.CacheControl] = "private, max-age=3600";
            return Results.File(
                path,
                GetContentType(path),
                enableRangeProcessing: true,
                lastModified: File.GetLastWriteTimeUtc(path));
        });
    }

    private void MapDiagnostics(WebApplication app)
    {
        app.MapGet($"/{_sessionToken}/diagnostics", async (HttpContext context) =>
        {
            var persistentCookieWasPresent = context.Request.Cookies.TryGetValue(
                GateZeroCookieName,
                out var cookieValue)
                && cookieValue.Equals("present", StringComparison.Ordinal);
            SetSessionCookie(context.Response);
            context.Response.Cookies.Append(GateZeroCookieName, "present", new CookieOptions
            {
                Expires = DateTimeOffset.UtcNow.AddDays(30),
                HttpOnly = false,
                IsEssential = true,
                MaxAge = TimeSpan.FromDays(30),
                SameSite = Microsoft.AspNetCore.Http.SameSiteMode.Strict,
                Path = "/",
            });
            AddHtmlSecurityHeaders(context.Response);
            var fixture = Convert.ToBase64String(
                await File.ReadAllBytesAsync(_solFixturePath!, context.RequestAborted).ConfigureAwait(false));
            return Results.Content(
                BuildDiagnosticsPage(fixture, persistentCookieWasPresent),
                "text/html; charset=utf-8");
        });

        app.MapGet($"/{_sessionToken}/fixtures/external-interface", (HttpContext context) =>
        {
            SetSessionCookie(context.Response);
            AddHtmlSecurityHeaders(context.Response);
            return Results.Content(
                BuildExternalInterfacePage(),
                "text/html; charset=utf-8");
        });

        app.MapGet(
            $"/{_sessionToken}/fixtures/external-interface/{ExternalInterfaceSwfFileName}",
            (HttpContext context) =>
            {
                if (!IsAuthorizedContentRequest(context))
                {
                    return Results.NotFound();
                }

                context.Response.Headers[HeaderNames.CacheControl] = "no-store";
                var path = Path.Combine(
                    _externalInterfaceFixtureDirectory!,
                    ExternalInterfaceSwfFileName);
                return Results.File(
                    path,
                    GetContentType(path),
                    enableRangeProcessing: true,
                    lastModified: File.GetLastWriteTimeUtc(path));
            });

        app.MapGet($"/{_sessionToken}/fixtures/popup", (HttpContext context) =>
        {
            AddHtmlSecurityHeaders(context.Response);
            return Results.Content(
                "<!doctype html><meta charset=\"utf-8\"><title>Popup passed</title>" +
                "<style>body{font:16px system-ui;padding:32px;background:#171a21;color:#f5f7fa}</style>" +
                "<h1>Popup routing passed</h1>",
                "text/html; charset=utf-8");
        });

        app.MapGet($"/{_sessionToken}/fixtures/download.txt", () => Results.Text(
            "CefFlashBrowser Gate 0 download fixture.\n",
            "text/plain; charset=utf-8"));

    }

    private string BuildPlayerPage(Registration registration, IReadOnlyList<RuffleSaveEntry> saves)
    {
        var publicPath = RufflePublicPath
            ?? throw new InvalidOperationException("The local content host has not started.");
        var escapedFileName = Uri.EscapeDataString(registration.FileName);
        var swfUrl = new Uri(BaseUri!, $"content/{registration.Id}/{escapedFileName}?session={_sessionToken}");
        var baseUrl = new Uri(swfUrl, "./");
        var saveValues = saves.ToDictionary(save => save.Key, save => save.Base64Data, StringComparer.Ordinal);
        using var storageReloadSource = new StreamReader(typeof(LoopbackContentHost).Assembly.GetManifestResourceStream(
            "FlashMacOS.Flash.Ruffle.Runtime.RuffleStorageReload.js")!);
        var storageReload = storageReloadSource.ReadToEnd();
        using var controlsSource = new StreamReader(typeof(LoopbackContentHost).Assembly.GetManifestResourceStream(
            "FlashMacOS.Flash.Ruffle.Runtime.RuffleControls.js")!);
        var controls = controlsSource.ReadToEnd();
        using var metadataSource = new StreamReader(typeof(LoopbackContentHost).Assembly.GetManifestResourceStream(
            "FlashMacOS.Flash.Ruffle.Runtime.RuffleMetadata.js")!);
        var metadata = metadataSource.ReadToEnd();

        return $$"""
            <!doctype html>
            <html lang="en">
            <head>
              <meta charset="utf-8">
              <meta name="viewport" content="width=device-width,initial-scale=1">
              <title>{{WebUtility.HtmlEncode(registration.FileName)}} — {{WebUtility.HtmlEncode(FlashMacOS.Domain.Identity.ProductIdentity.Name)}}</title>
              <style>
                html, body, #player { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #11151d; }
                ruffle-player { width: 100%; height: 100%; display: block; }
              </style>
              <script>
                {{RuffleDocumentStartScriptBuilder.BuildPageBootstrap(publicPath)}}
                const restoredSaves = {{JsonSerializer.Serialize(saveValues, HtmlJsonOptions)}};
                for (const [key, value] of Object.entries(restoredSaves)) localStorage.setItem(key, value);

                window.__cefFlashBrowserEnsureRuffle = () => {
                  if (window.RufflePlayer?.newest) return Promise.resolve();
                  return new Promise((resolve, reject) => {
                    const script = document.createElement("script");
                    script.src = {{JsonSerializer.Serialize(new Uri(publicPath, "ruffle.js").AbsoluteUri)}};
                    script.onload = resolve;
                    script.onerror = () => reject(new Error("Failed to load the bundled Ruffle runtime."));
                    document.head.appendChild(script);
                  });
                };
              </script>
            </head>
            <body>
              <div id="player"></div>
            <script>
                {{storageReload}}
                {{controls}}
                {{metadata}}
                (async () => {
                  try {
                    await window.__cefFlashBrowserEnsureRuffle();
                    const player = window.RufflePlayer.newest().createPlayer();
                    player.id = "cfb-player";
                    document.getElementById("player").appendChild(player);
                    const api = player.ruffle(1);
                    window.__flashMacOSGameConfiguration = {{JsonSerializer.Serialize(registration.Configuration, HtmlJsonOptions)}};
                    window.__cefFlashBrowserPlayer = player;
                    let traceObserverActive = true;
                    let initialLoad = true;
                    const traceBindings = new Set();
                    const runWithTraceObserver = async (operation, signal) => {
                      const runId = window.__flashMacOSBeginRun?.() || crypto.randomUUID();
                      const observeTrace = message => {
                        if (traceObserverActive && (!window.__flashMacOSRunId || window.__flashMacOSRunId === runId)) {
                          window.__cefFlashBrowserPost({ type: "trace", message, runId });
                        }
                      };
                      const installTraceObserver = () => {
                        if (window.__flashMacOSRunId && window.__flashMacOSRunId !== runId) return;
                        player.traceObserver = observeTrace;
                        api.traceObserver = observeTrace;
                      };
                      traceBindings.add(installTraceObserver);
                      player.addEventListener("loadedmetadata", installTraceObserver, { once: true });
                      try { await operation(); installTraceObserver(); await __flashMacOSWaitForMetadata(player, api, signal); }
                      finally { player.removeEventListener("loadedmetadata", installTraceObserver); traceBindings.delete(installTraceObserver); }
                      if (!traceObserverActive) return;
                      installTraceObserver();
                      if (initialLoad) api.volume = {{registration.Configuration.Volume.ToString("R", System.Globalization.CultureInfo.InvariantCulture)}};
                      initialLoad = false;
                      if (!window.__flashMacOSRunId || window.__flashMacOSRunId === runId)
                        window.__cefFlashBrowserPost({ type: "playerReady", runId, message: {{JsonSerializer.Serialize(registration.FileName)}} });
                    };
                    window.addEventListener("pagehide", () => {
                      traceObserverActive = false;
                      for (const binding of traceBindings) player.removeEventListener("loadedmetadata", binding);
                      traceBindings.clear();
                      player.traceObserver = null;
                      api.traceObserver = null;
                    }, { once: true });
                    window.__cefFlashBrowserPlayerApi = {
                      suspend: () => api.suspend(),
                      resume: () => api.resume(),
                      reload: (updateStorage, signal) => runWithTraceObserver(() =>
                        window.__cefFlashBrowserReloadWithStorage(player, api, updateStorage), signal),
                      requestFullscreen: () => api.requestFullscreen(),
                      get isFullscreen() { return api.isFullscreen; },
                      get suspended() { return api.suspended; },
                      get volume() { return api.volume; },
                      set volume(value) { api.volume = value; }
                    };
                    await runWithTraceObserver(() => api.load({
                      url: {{JsonSerializer.Serialize(swfUrl.AbsoluteUri)}},
                      base: {{JsonSerializer.Serialize(baseUrl.AbsoluteUri)}},
                      quality: {{JsonSerializer.Serialize(registration.Configuration.Quality)}},
                      scale: {{JsonSerializer.Serialize(registration.Configuration.Scale)}},
                      autoplay: "on",
                      unmuteOverlay: "visible",
                      allowScriptAccess: true,
                      allowFullscreen: true,
                      warnOnUnsupportedContent: true
                    }));
                  } catch (error) {
                    if (error?.name === "AbortError") return;
                    const description = `${error?.name || "Error"}: ${error?.message || String(error)}`;
                    document.getElementById("player").textContent = `Unable to play this SWF. ${description}`;
                    window.__cefFlashBrowserPost({
                      type: "bridgeError",
                      message: `${description}\n${error?.stack || ""}`
                    });
                  }
                })();
              </script>
            </body>
            </html>
            """;
    }

    private string BuildExternalInterfacePage()
    {
        var publicPath = RufflePublicPath
            ?? throw new InvalidOperationException("The local content host has not started.");
        var swfUrl = new Uri(
            BaseUri!,
            $"{_sessionToken}/fixtures/external-interface/{ExternalInterfaceSwfFileName}");

        return $$"""
            <!doctype html>
            <html lang="en">
            <head>
              <meta charset="utf-8">
              <meta name="viewport" content="width=device-width,initial-scale=1">
              <title>ExternalInterface — {{WebUtility.HtmlEncode(FlashMacOS.Domain.Identity.ProductIdentity.Name)}}</title>
              <style>
                :root { color-scheme: dark; font-family: system-ui, sans-serif; }
                body { margin: 0; padding: 24px; background: #11151d; color: #eef2f8; }
                main { max-width: 860px; margin: auto; }
                #player { width: 550px; max-width: 100%; height: 400px; margin: 18px 0; background: #fff; }
                ruffle-player { width: 100%; height: 100%; display: block; }
                #result { display: block; padding: 12px; border-radius: 8px; background: #1a202b; color: #8fd3ff; }
                #details { color: #ffb4ab; white-space: pre-wrap; }
              </style>
              <script>
                {{RuffleDocumentStartScriptBuilder.BuildPageBootstrap(publicPath)}}
                window.__cefFlashBrowserEnsureRuffle = () => {
                  if (window.RufflePlayer?.newest) return Promise.resolve();
                  return new Promise((resolve, reject) => {
                    const script = document.createElement("script");
                    script.src = {{JsonSerializer.Serialize(new Uri(publicPath, "ruffle.js").AbsoluteUri)}};
                    script.onload = resolve;
                    script.onerror = () => reject(new Error("Failed to load the bundled Ruffle runtime."));
                    document.head.appendChild(script);
                  });
                };
              </script>
            </head>
            <body>
              <main>
                <h1>ExternalInterface bidirectional gate</h1>
                <p>This runner checks the pinned Ruffle v0.4.1 fixture without network access.</p>
                <code id="result">RUNNING</code>
                <pre id="details"></pre>
                <div id="player"></div>
              </main>
              <script>
                (async () => {
                  let resultPosted = false;
                  let checksCompleted = false;
                  const result = {
                    available: false,
                    jsToAs: null,
                    asToJs: false,
                    structured: false
                  };
                  const traces = [];
                  let player = null;
                  let api = null;

                  const canonicalize = value => {
                    if (Array.isArray(value)) return value.map(canonicalize);
                    if (value !== null && typeof value === "object") {
                      return Object.keys(value)
                        .sort()
                        .reduce((normalized, key) => {
                          normalized[key] = canonicalize(value[key]);
                          return normalized;
                        }, {});
                    }
                    return value;
                  };
                  const waitFor = (condition, label, timeoutMilliseconds = 5000) =>
                    new Promise((resolve, reject) => {
                      const started = performance.now();
                      const poll = () => {
                        try {
                          if (condition()) {
                            resolve();
                          } else if (performance.now() - started >= timeoutMilliseconds) {
                            reject(new Error("Timed out waiting for " + label + "."));
                          } else {
                            setTimeout(poll, 25);
                          }
                        } catch (error) {
                          reject(error);
                        }
                      };
                      poll();
                    });
                  const withTimeout = (promise, label, timeoutMilliseconds = 5000) =>
                    new Promise((resolve, reject) => {
                      const timer = setTimeout(
                        () => reject(new Error("Timed out waiting for " + label + ".")),
                        timeoutMilliseconds);
                      promise.then(
                        value => {
                          clearTimeout(timer);
                          resolve(value);
                        },
                        error => {
                          clearTimeout(timer);
                          reject(error);
                        });
                    });
                  const publishResult = () => {
                    if (resultPosted) return;
                    resultPosted = true;
                    const passed = checksCompleted
                      && result.available === true
                      && result.jsToAs === 123.4
                      && result.asToJs === true
                      && result.structured === true;
                    const summary = "available=" + result.available
                      + " jsToAs=" + result.jsToAs
                      + " asToJs=" + result.asToJs
                      + " structured=" + result.structured;
                    const message = (passed ? "PASS " : "FAIL ") + summary;
                    const data = JSON.stringify({
                      available: result.available,
                      jsToAs: result.jsToAs,
                      asToJs: result.asToJs,
                      structured: result.structured
                    });
                    document.getElementById("result").textContent = message;
                    window.__cefFlashBrowserPost({
                      type: "compatibilityResult",
                      key: "external-interface/v1",
                      message,
                      data
                    });
                  };

                  try {
                    await window.__cefFlashBrowserEnsureRuffle();
                    player = window.RufflePlayer.newest().createPlayer();
                    player.id = "flash_id";
                    player.setAttribute("name", "flash_name");
                    document.getElementById("player").appendChild(player);
                    api = player.ruffle(1);

                    const observeTrace = message => traces.push(String(message));
                    const installTraceObserver = () => {
                      player.traceObserver = observeTrace;
                      api.traceObserver = observeTrace;
                    };
                    player.addEventListener("loadedmetadata", installTraceObserver, { once: true });
                    window.addEventListener("pagehide", () => {
                      player.traceObserver = null;
                      api.traceObserver = null;
                      delete window.CefFlashBrowserExternalInterface;
                    }, { once: true });

                    await api.load({
                      url: {{JsonSerializer.Serialize(swfUrl.AbsoluteUri)}},
                      autoplay: "on",
                      unmuteOverlay: "visible",
                      allowScriptAccess: true,
                      warnOnUnsupportedContent: true
                    });
                    installTraceObserver();
                    await waitFor(
                      () => traces.includes("ExternalInterface.available: true")
                        && typeof player.returnAValue === "function"
                        && typeof player.callMethodWithDelay === "function",
                      "ExternalInterface callbacks");
                    result.available = true;

                    result.jsToAs = await Promise.resolve(
                      api.callExternalInterface("returnAValue", 123.4));

                    const structuredInput = {
                      string: "roundtrip",
                      number: 123.4,
                      boolean: true,
                      nullValue: null,
                      array: ["item", 7, false, null],
                      object: { nested: "value" }
                    };
                    const structuredOutput = await Promise.resolve(
                      api.callExternalInterface("returnAValue", structuredInput));
                    result.structured = JSON.stringify(canonicalize(structuredOutput))
                      === JSON.stringify(canonicalize(structuredInput));

                    let resolveAsToJs;
                    const asToJsCallback = new Promise(resolve => {
                      resolveAsToJs = resolve;
                    });
                    window.CefFlashBrowserExternalInterface = {
                      set(value) {
                        resolveAsToJs(value === true);
                        return true;
                      }
                    };
                    const callbackName = "window.CefFlashBrowserExternalInterface.set";
                    await Promise.resolve(
                      api.callExternalInterface("callMethodWithDelay", callbackName, true));
                    result.asToJs = await withTimeout(asToJsCallback, "delayed AS3 to JS callback");
                    await waitFor(
                      () => traces.some(
                        message => message.includes(
                          "call(" + callbackName + ", ...) = true")),
                      "the true callback return trace");

                    checksCompleted = true;
                    publishResult();
                  } catch (error) {
                    publishResult();
                    const description = (error?.name || "Error") + ": "
                      + (error?.message || String(error));
                    document.getElementById("details").textContent = description;
                    window.__cefFlashBrowserPost({
                      type: "bridgeError",
                      message: description
                    });
                  }
                })();
              </script>
            </body>
            </html>
            """;
    }

