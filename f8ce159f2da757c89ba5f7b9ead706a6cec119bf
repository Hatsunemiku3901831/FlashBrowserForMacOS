namespace FlashMacOS.Infrastructure.Paths;

public static class BundleResourceLocator
{
    public static string ResolveRoot()
    {
        var appBase = Path.GetFullPath(AppContext.BaseDirectory);
        var bundleResources = Path.GetFullPath(Path.Combine(appBase, "..", "Resources"));
        return Directory.Exists(Path.Combine(bundleResources, "Assets"))
            ? bundleResources
            : appBase;
    }
}
