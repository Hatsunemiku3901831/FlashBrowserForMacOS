                    new { saved, cancelled, staging = Staging() });
                return new { saved, cancelled };
            }).ConfigureAwait(false);
            await Check("popup-local-player-profile", "A popup opened by the LocalPlayer surface uses the LocalPlayer data store, not Web", async () =>
            {
                await Script(h.Local, "document.cookie='W02-Popup=local;path=/;SameSite=Lax'").ConfigureAwait(false);
                await h.Workspace.NavigateAsync(h.LocalPlayerPage, token).ConfigureAwait(false);
                await Until(() => Task.FromResult(Settled(h.Local) && h.Local.State.Address == h.LocalPlayerPage)).ConfigureAwait(false);
                var before = await PopupSessions().ConfigureAwait(false);
                await Script(h.Local, $"window.open({JsonSerializer.Serialize(new Uri(site, "popup/child?via=local").AbsoluteUri)})").ConfigureAwait(false);
                var popup = await NewPopup(before).ConfigureAwait(false);
                var cookie = await Text(popup.Session, "document.cookie").ConfigureAwait(false);
                Require(popup.Purpose == BrowserPurpose.LocalPlayer && cookie.Contains("W02-Popup=local", StringComparison.Ordinal) && !cookie.Contains("W02-Popup=web", StringComparison.Ordinal),
                    new { popup.Purpose, cookie });
                await popup.CloseAsync().ConfigureAwait(false); await Released(before.Length, surfaces).ConfigureAwait(false);
                await h.Workspace.NavigateAsync(site, token).ConfigureAwait(false);
                await Until(() => Task.FromResult(Settled(web) && web.State.Address == site)).ConfigureAwait(false);
                return new { purpose = popup.Purpose, cookie };
            }).ConfigureAwait(false);
            await Check("no-staging-residue", "No hidden staging file remains anywhere under the download directory", () =>
                Task.FromResult<object>(new { staging = Staging() is { Length: 0 } none ? none : throw new InvalidDataException(string.Join(", ", Staging())) })).ConfigureAwait(false);

            await Check("popup-native-window-release", "After popup closure and managed finalization, NSApplication retains only the original windows", async () =>
            {
                var beforeFinalization = await NativeWindowDiagnostics.SnapshotAsync().ConfigureAwait(false);
                GC.Collect(); GC.WaitForPendingFinalizers(); GC.Collect();
                var afterFinalization = await NativeWindowDiagnostics.SnapshotAsync().ConfigureAwait(false);
                var originalIds = initialWindows.GetProperty("windows").EnumerateArray().Select(w => w.GetProperty("id").GetInt32()).ToHashSet();
                Require(afterFinalization.GetProperty("windows").EnumerateArray().All(w => originalIds.Contains(w.GetProperty("id").GetInt32())),
                    new { initialWindows, beforeFinalization, afterFinalization });
                return new { initialWindows, beforeFinalization, afterFinalization };
            }).ConfigureAwait(false);

            await Check("quit-check-prepared", "One popup with a running download stays open for the operator's real Quit; the journal must show both released", async () =>
            {
                if (h.Workspace.State.Address != site || !Settled(web))
                {
                    await h.Workspace.NavigateAsync(site, token).ConfigureAwait(false);
                    await Until(() => Task.FromResult(Settled(web) && web.State.Address == site)).ConfigureAwait(false);
                }
                var before = await PopupSessions().ConfigureAwait(false);
                await Script(web, "window.open(base+'/popup/child?via=quit-check')").ConfigureAwait(false);
                var popup = await NewPopup(before).ConfigureAwait(false); var marker = "quit-" + Marker(); var last = Last();
                await Script(popup.Session, $"location.href='../file/slow?ms=600000&n={marker}'").ConfigureAwait(false);
                var running = await Running(last, i => i.Address?.Query.Contains(marker, StringComparison.Ordinal) == true).ConfigureAwait(false);
                return new { running, popups = (await h.Popups().ConfigureAwait(false)).Count, surfaces = h.RetainedSurfaces() };
            }).ConfigureAwait(false);
            var summary = new { status = failed == 0 ? "PASS" : "FAIL", failures = failed, process = Environment.ProcessId, site, files,
                environment = new { os = Environment.OSVersion.VersionString, architecture = System.Runtime.InteropServices.RuntimeInformation.ProcessArchitecture.ToString(),
                    runtime = System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription }, checks,
                manual = "Save panel, replace confirmation, HTTP Basic sheet and quit-with-open-popup are verified by real operation and journal, not inferred here" };
            await File.WriteAllTextAsync(report, JsonSerializer.Serialize(summary, ReportOptions), token).ConfigureAwait(false);
            await Script(web, "document.getElementById('host').textContent=" + JsonSerializer.Serialize($"W02 native checks: {(failed == 0 ? "PASS" : "FAIL")} ({checks.Count - failed}/{checks.Count})")).ConfigureAwait(false);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        { await File.AppendAllTextAsync(journal, JsonSerializer.Serialize(new { status = "CANCELLED", checksCompleted = checks.Count }) + Environment.NewLine, CancellationToken.None).ConfigureAwait(false); }
        catch (Exception exception)
        { await File.WriteAllTextAsync(report, JsonSerializer.Serialize(new { status = "FAIL", error = exception.ToString(), checks }), CancellationToken.None).ConfigureAwait(false); }
    }

    private static bool Settled(IBrowserSession session) => !session.State.IsLoading && session.State.NavigationId is not null && session.State.Error is null;
}
