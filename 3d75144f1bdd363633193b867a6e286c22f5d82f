            await Check("cross-origin-redirect-download", "302 from the first origin to the second: final bytes from the second origin, one request each", async () =>
            {
                var marker = Marker(); var before = Last(); var page = Page(web);
                await Script(web, $"__w02.anchor('redirect?check={marker}',null,null)").ConfigureAwait(false);
