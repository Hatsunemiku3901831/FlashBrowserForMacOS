public sealed record DownloadVerificationHarness(IBrowserSession Workspace, IBrowserSession Web, IBrowserSession Local, Uri LocalPlayerPage,
    DownloadManager Downloads, DiagnosticDownloadDestinations Destinations, Func<Task<IReadOnlyList<PopupProbe>>> Popups,
    Func<int> RetainedSurfaces, Uri Site, string Root);

/// <summary>
/// Test-profile automated destinations: a fixed directory, unique names by default, and explicit per-file plans
/// (an existing target to replace, or null to decline) set by the native verification.
/// </summary>
public sealed class DiagnosticDownloadDestinations(string root) : IDownloadDestinations
{
    private readonly ConcurrentDictionary<string, string?> _plans = new(StringComparer.Ordinal);
    private int _sequence;

    public string Root { get; } = root;

    public void Plan(string suggestedFileName, string? destination) => _plans[suggestedFileName] = destination;

    public ValueTask<string?> ChooseAsync(BrowserDownloadRequest request, CancellationToken cancellationToken = default)
    {
        cancellationToken.ThrowIfCancellationRequested();
        if (_plans.TryRemove(request.SuggestedFileName, out var planned)) return ValueTask.FromResult(planned);
        Directory.CreateDirectory(Root);
        return ValueTask.FromResult<string?>(Path.Combine(Root, $"{Interlocked.Increment(ref _sequence):D3}-{request.SuggestedFileName}"));
    }
}

/// <summary>Explicit Test-profile W02 native evidence; never part of an ordinary product session.</summary>
public static class DownloadPopupNativeVerification
{
    private static readonly JsonSerializerOptions ReportOptions = new() { WriteIndented = true };
    private static readonly TimeSpan Wait = TimeSpan.FromSeconds(30);

    public static async Task RunAsync(DownloadVerificationHarness h, CancellationToken token)
    {
        var directory = Path.Combine(h.Root, "download-verification"); Directory.CreateDirectory(directory);
        var files = h.Destinations.Root; Directory.CreateDirectory(files);
        var id = $"{DateTimeOffset.UtcNow:yyyyMMddTHHmmssfffZ}-{Environment.ProcessId}-{Guid.NewGuid():N}";
        var journal = Path.Combine(directory, id + ".jsonl"); var report = Path.Combine(directory, id + ".json");
        var checks = new List<object>(); var failed = 0;
        using var handler = new HttpClientHandler { UseProxy = false, UseCookies = false, AllowAutoRedirect = false };
        using var http = new HttpClient(handler) { Timeout = TimeSpan.FromSeconds(10) }; // Observation reader only.
        var web = h.Web; var site = h.Site; var downloads = (IBrowserDownloads)web;

        async Task Check(string name, string expected, Func<Task<object>> operation)
        {
            var watch = Stopwatch.StartNew(); object result;
            try { result = new { name, expected, status = "PASS", actual = await operation().ConfigureAwait(false), elapsedMs = watch.Elapsed.TotalMilliseconds }; }
            catch (OperationCanceledException) when (token.IsCancellationRequested) { throw; }
            catch (Exception exception) { failed++; result = new { name, expected, status = "FAIL", error = exception.ToString(), elapsedMs = watch.Elapsed.TotalMilliseconds }; }
            checks.Add(result); await File.AppendAllTextAsync(journal, JsonSerializer.Serialize(result) + Environment.NewLine, token).ConfigureAwait(false);
        }
        static void Require(bool condition, object actual) { if (!condition) throw new InvalidDataException(actual as string ?? JsonSerializer.Serialize(actual)); }
        async Task Until(Func<Task<bool>> condition, TimeSpan? limit = null)
        {
            using var bounded = CancellationTokenSource.CreateLinkedTokenSource(token); bounded.CancelAfter(limit ?? Wait);
            while (!await condition().ConfigureAwait(false)) await Task.Delay(50, bounded.Token).ConfigureAwait(false);
        }
        async Task Load(IBrowserSession session, Uri uri)
        {
            var previous = session.State.NavigationSequence;
            await session.NavigateAsync(uri, token).ConfigureAwait(false);
            await Until(() => Task.FromResult(Settled(session) && session.State.NavigationSequence > previous)).ConfigureAwait(false);
        }
        async Task<string> Text(IBrowserSession session, string expression)
            => JsonSerializer.Deserialize<string>(await session.ExecuteScriptAsync("JSON.stringify(" + expression + ")", token).ConfigureAwait(false) ?? "null") ?? "";
        async Task Script(IBrowserSession session, string script) => await session.ExecuteScriptAsync(script + ";true", token).ConfigureAwait(false);
        long Last() => h.Downloads.Items.Select(item => item.Sequence).DefaultIfEmpty(0).Max();
        async Task<DownloadItem> Finished(long after, Func<DownloadItem, bool> match)
        {
            DownloadItem? found = null;
            await Until(() => Task.FromResult((found = h.Downloads.Items.FirstOrDefault(item => item.Sequence > after && match(item) && item.IsTerminal)) is not null)).ConfigureAwait(false);
            return found!;
        }
        async Task<DownloadItem> Running(long after, Func<DownloadItem, bool> match)
        {
            DownloadItem? found = null;
            await Until(() => Task.FromResult((found = h.Downloads.Items.FirstOrDefault(item => item.Sequence > after && match(item)
                && item.Status == DownloadStatus.Running && item.ReceivedBytes > 0)) is not null)).ConfigureAwait(false);
            return found!;
        }
        async Task<JsonElement[]> Served(string marker)
        {
            using var document = JsonDocument.Parse(await http.GetStringAsync(new Uri(site, "observations"), token).ConfigureAwait(false));
            return document.RootElement.EnumerateArray().Where(o => o.GetProperty("query").GetString()!.Contains(marker, StringComparison.Ordinal))
                .Select(o => o.Clone()).ToArray();
        }
        async Task<PopupProbe> NewPopup(IReadOnlyCollection<IBrowserSession> before)
        {
            PopupProbe? found = null;
            await Until(async () => (found = (await h.Popups().ConfigureAwait(false)).FirstOrDefault(p => !before.Contains(p.Session))) is not null).ConfigureAwait(false);
            await Until(() => Task.FromResult(Settled(found!.Session))).ConfigureAwait(false);
            return found!;
        }
        async Task<IBrowserSession[]> PopupSessions() => (await h.Popups().ConfigureAwait(false)).Select(p => p.Session).ToArray();
        async Task Released(int popups, int surfaces)
            => await Until(async () => (await h.Popups().ConfigureAwait(false)).Count == popups && h.RetainedSurfaces() == surfaces).ConfigureAwait(false);
        static string Marker() => Guid.NewGuid().ToString("N")[..12];
        static string Sha(byte[] bytes) => Convert.ToHexStringLower(SHA256.HashData(bytes));
        static string FileSha(string path) => Sha(File.ReadAllBytes(path));
        static byte[] Pattern(int length) { var b = new byte[length]; for (var i = 0; i < length; i++) b[i] = (byte)((i * 31 + 7) & 255); return b; }
        string[] Staging() => Directory.EnumerateFiles(files, "*.flashmacos-download", SearchOption.AllDirectories).ToArray();
        object Page(IBrowserSession s) => new { s.State.Address, s.State.NavigationId, s.State.IsLoading, s.State.Error };
        void SamePage(object before, IBrowserSession s) => Require(JsonSerializer.Serialize(before) == JsonSerializer.Serialize(Page(s)) && s.State.Error is null,
            new { before, after = Page(s) });
