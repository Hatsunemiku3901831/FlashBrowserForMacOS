using FlashMacOS.Application.Navigation;
using FlashMacOS.Domain.Configuration;

namespace FlashMacOS.Application.Configuration;

public sealed class SettingsService(ISettingsRepository repository) : IDisposable
{
    private readonly SemaphoreSlim _gate = new(1, 1);
    public ConfigurationSnapshot<AppSettings>? Current { get; private set; }

    public async ValueTask<ConfigurationSnapshot<AppSettings>> LoadAsync(CancellationToken cancellationToken = default)
    {
        await _gate.WaitAsync(cancellationToken).ConfigureAwait(false);
        try { return Current = await repository.LoadAsync(cancellationToken).ConfigureAwait(false); }
        finally { _gate.Release(); }
    }

    public async ValueTask<ConfigurationSnapshot<AppSettings>> UpdateAsync(AppSettings candidate, string expectedRevision,
        CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(candidate);
        candidate.Validate();
        await _gate.WaitAsync(cancellationToken).ConfigureAwait(false);
        try
        {
            var committed = await repository.SaveAsync(candidate, expectedRevision, cancellationToken).ConfigureAwait(false);
            Current = committed;
            return committed;
        }
        finally { _gate.Release(); }
    }

    public static Uri ResolveAddress(string input, AppSettings settings)
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(input);
        settings.Validate();
        return settings.NavigationType switch
        {
            NavigationType.SearchOnly => new Uri(NavigationResolver.GetSearchUrl(settings.SearchEngine, input.Trim())),
            NavigationType.NavigateOnly => Uri.TryCreate(input.Trim(), UriKind.Absolute, out var absolute) && absolute.Scheme != "file"
                ? absolute : new Uri("http://" + input.Trim()),
            _ => NavigationResolver.Resolve(input, settings.SearchEngine),
        };
    }

    public void Dispose() => _gate.Dispose();
}
