"""Transcribe normative examples by hand. No production AMF reader or writer is used."""
from pathlib import Path
import hashlib
import json

ROOT = Path(__file__).resolve().parents[4]
DEST = ROOT / 'test-assets/sol-golden'
DEST.mkdir(exist_ok=True)
rows = []
def add(name, encoding, hex_bytes, expected, sections, canonical=True, diagnostic=None):
    data = bytes.fromhex(hex_bytes)
    path = DEST / (name + '.amf' + str(encoding))
    path.write_bytes(data)
    rows.append({'id': name, 'path': str(path.relative_to(ROOT)), 'encoding': encoding,
                 'sha256': hashlib.sha256(data).hexdigest(), 'bytes': len(data), 'hex': data.hex(),
                 'expected': expected, 'specSections': sections, 'canonicalWriterBytes': canonical,
                 'diagnostic': diagnostic})

