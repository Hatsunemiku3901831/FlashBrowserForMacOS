from pathlib import Path
import subprocess
import sys
import unittest

ROOT = Path(__file__).resolve().parents[2]


class NativeProfileSeedingTests(unittest.TestCase):
    def test_product_profile_cannot_be_seeded_by_a_test_fixture(self):
        result = subprocess.run([sys.executable, str(ROOT / 'scripts/run-native.py'), '--run-id', 'rejected-seed',
                                 '--package-run', 'not-created', '--default-profile', '--settings-fixture',
                                 str(ROOT / 'test-assets/configuration/legacy-settings-all.json')], capture_output=True, text=True)
        self.assertEqual(2, result.returncode)
        self.assertIn('Fixture seeding requires a new Test profile', result.stderr)

    def test_runtime_data_is_not_accepted_as_a_fixture(self):
        result = subprocess.run([sys.executable, str(ROOT / 'scripts/run-native.py'), '--run-id', 'rejected-seed',
                                 '--package-run', 'not-created', '--settings-fixture', str(ROOT / 'README.md')], capture_output=True, text=True)
        self.assertEqual(2, result.returncode)
        self.assertIn('under test-assets/configuration', result.stderr)
