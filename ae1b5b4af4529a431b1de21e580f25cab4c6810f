<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CefFlashBrowser.MacOS.Spike.Desktop.Views.PopupWindow"
        Title="CefFlashBrowser popup"
        Width="820"
        Height="620"
        MinWidth="480"
        MinHeight="360">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="9" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="7">
        <Button Grid.Column="0" Classes="toolbar" Content="←" Click="OnBackClick" />
        <Button Grid.Column="1" Classes="toolbar" Content="→" Click="OnForwardClick" />
        <Button Grid.Column="2" Classes="toolbar" Content="Reload" Click="OnReloadClick" />
        <TextBox Grid.Column="3" x:Name="AddressBox" IsReadOnly="True" />
      </Grid>
    </Border>
    <ContentControl Grid.Row="1" x:Name="BrowserHost" />
  </Grid>
</Window>
