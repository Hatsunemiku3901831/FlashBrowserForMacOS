name: ARM64 managed checks
on: workflow_dispatch
permissions:
  contents: read
jobs:
  verify:
    runs-on: [self-hosted, macOS, ARM64]
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Check local Apple Silicon toolchain
        run: |
          test "$(uname -m)" = arm64
          test "$(dotnet --version)" = 10.0.301
          python3 --version
      - name: Locked managed verification
        run: sh scripts/verify.sh --run-id "ci-${{ github.run_id }}-${{ github.run_attempt }}"
