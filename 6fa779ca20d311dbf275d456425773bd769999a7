def sha(p): return hashlib.sha256(p.read_bytes()).hexdigest()
def transform(s):
    mapping = {
        'CefFlashBrowser.MacOS.Spike.Core.Application.Browser': 'FlashMacOS.Application.Browser',
        'CefFlashBrowser.MacOS.Spike.Core.Application.Navigation': 'FlashMacOS.Application.Navigation',
        'CefFlashBrowser.MacOS.Spike.Core.Flash.Hosting': 'FlashMacOS.Application.Flash',
        'CefFlashBrowser.MacOS.Spike.Core.Flash.Ruffle': 'FlashMacOS.Application.Flash',
        'CefFlashBrowser.MacOS.Spike.Core.Flash.Storage': 'FlashMacOS.Application.Flash',
        'CefFlashBrowser.MacOS.Spike.Core.Infrastructure.Paths': 'FlashMacOS.Infrastructure.Paths',
        'CefFlashBrowser.MacOS.Spike.Desktop.Browser': 'FlashMacOS.Browser.WebKit',
        'CefFlashBrowser.MacOS.Spike.Desktop.Platform.MacOS': 'FlashMacOS.Browser.WebKit',
        'CefFlashBrowser.MacOS.Spike.Desktop.Diagnostics': 'FlashMacOS.Infrastructure.Diagnostics',
        'CefFlashBrowser.MacOS.Spike.Desktop': 'FlashMacOS.Desktop',
    }
    for a,b in mapping.items(): s=s.replace(a,b)
    return s

def write(relative, s, source=None, reason='A01 authored desktop composition through application ports'):
    p=ROOT/relative
    data=s.encode()
    if p.exists() and p.read_bytes()!=data: raise ValueError('Preserving conflicting file: '+relative)
    p.parent.mkdir(parents=True,exist_ok=True)
    if not p.exists():p.write_bytes(data)
    original=ROOT/'reference/legacy/spike/macos-host'/source.relative_to(BOOT) if source else None
    entries.append({'bootstrapSourcePath':str(source.relative_to(ROOT)) if source else None,
        'bootstrapSourceSha256':sha(source) if source else None,
        'originalSourcePath':str(original.relative_to(ROOT/'reference/legacy')) if original and original.is_file() else None,
        'originalSourceSha256':sha(original) if original and original.is_file() else None,
        'targetPath':relative,'targetSha256':sha(p),'reason':reason})

