        {
            var files = await storageProvider().OpenFilePickerAsync(new FilePickerOpenOptions
            {
                Title = title, AllowMultiple = false, FileTypeFilter = Types(kind),
            });
            cancellationToken.ThrowIfCancellationRequested();
            return files.Count > 0 ? files[0].TryGetLocalPath() : null;
        });
    }

    public async ValueTask<string?> SaveAsync(NativeFileKind kind, string title, string suggestedName,
        string? defaultExtension = null, CancellationToken cancellationToken = default)
    {
        cancellationToken.ThrowIfCancellationRequested();
        return await Dispatcher.UIThread.InvokeAsync(async () =>
        {
            var file = await storageProvider().SaveFilePickerAsync(new FilePickerSaveOptions
            {
                Title = title, SuggestedFileName = suggestedName, DefaultExtension = defaultExtension,
                FileTypeChoices = Types(kind),
            });
            cancellationToken.ThrowIfCancellationRequested();
            return file?.TryGetLocalPath();
        });
    }

    private static IReadOnlyList<FilePickerFileType>? Types(NativeFileKind kind) => kind switch
    {
        NativeFileKind.FlashMovie => [Swf], NativeFileKind.SharedObject => [Sol],
        NativeFileKind.Any => null, _ => throw new ArgumentOutOfRangeException(nameof(kind)),
    };
}
