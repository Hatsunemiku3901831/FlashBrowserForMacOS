"""Freeze a completed managed task. Reports/status are reviewed and updated separately."""
from pathlib import Path
from datetime import datetime, timezone
import argparse, hashlib, json, os, subprocess, tarfile
p=argparse.ArgumentParser();p.add_argument('--task',required=True);p.add_argument('--run',required=True);p.add_argument('--next',required=True);a=p.parse_args()
r=Path(__file__).resolve().parents[2];out=r/'docs/evidence'/a.task/'2026-10-28';out.mkdir(parents=True,exist_ok=True)
def sha(path):return hashlib.sha256(path.read_bytes()).hexdigest()
def save(path,value):path.write_text(json.dumps(value,ensure_ascii=False,indent=2)+'\n')
base=r/'artifacts/evidence'/a.task
result=json.loads((base/a.run/'result.json').read_text());inputs=json.loads((base/a.run/'inputs.json').read_text())['before']
assert result['status']=='PASS'
assert all(sha(r/path)==digest for path,digest in inputs.items())
prior=json.loads((r/'docs/provenance'/f'{a.task}-before.json').read_text())['files']
refs_path=r/'docs/provenance'/f'{a.task}-source-inputs.json'
refs=json.loads(refs_path.read_text())['inputs'] if refs_path.exists() else []
changes=[]
for path,digest in inputs.items():
 if prior.get(path)==digest:continue
 changes.append({'targetPath':path,'beforeSha256':prior.get(path),'targetSha256':digest,
 'reason':a.task+' implementation and nearest regression; see task report and support contract',
 'origin':'Project-authored implementation/manual fixture; reference algorithms are not runtime dependencies',
 'referenceSources':[{'originalSourcePath':row['originalSourcePath'],'originalSourceSha256':row['originalSourceSha256']}
                     for row in refs if any(path.startswith(target.rstrip('/')) for target in row['targetPaths'])]})
save(r/'docs/provenance'/f'{a.task}-changes.json',{'schemaVersion':1,'changes':changes})
source=Path('/Users/umisonoda/PycharmProjects/flash/CefFlashBrowser')
original=json.loads((r/'docs/evidence/P00/2026-10-28/source-state-before.json').read_text())
assert all(sha(source/path)==digest for path,digest in original['businessFiles'].items())
env={**os.environ,'GIT_OPTIONAL_LOCKS':'0'}
head=subprocess.check_output(['git','-C',str(source),'rev-parse','HEAD'],env=env,text=True).strip()
dirty=subprocess.check_output(['git','-C',str(source),'status','--short'],env=env,text=True)
assert head==original['head'] and dirty==original['worktreeStatus']
save(out/'source-preserved.json',{'taskId':a.task,'status':'PASS','checkedFiles':len(original['businessFiles']),
 'head':head,'worktreeStatus':dirty,'changes':{}})
old=json.loads((r/'docs/evidence/P03/2026-10-28/legacy-data-preserved.json').read_text());actual={}
for name in old['roots']:
 path=Path(name);actual[name]={'exists':path.exists(),'files':{str(f.relative_to(path)):sha(f) for f in path.rglob('*') if f.is_file()}}
assert actual==old['actual']
save(out/'legacy-data-preserved.json',{'taskId':a.task,'status':'PASS','roots':old['roots'],'changes':{},'actual':actual})
test_map=json.loads((r/'docs/provenance/A01-test-map.json').read_text());lookup={case['testName']:case for case in result['actual']['tests']}
for case in test_map['tests']:
 case['formal']=lookup[case['formal']['testName']];assert case['formal']['outcome']=='Passed'
test_map.update(destinationRun=a.run,formalTotal=result['actual']['testCount'])
save(r/'docs/provenance'/f'{a.task}-prototype-test-map.json',test_map)
save(r/'docs/provenance'/f'{a.next}-before.json',{'schemaVersion':1,'files':inputs})
with tarfile.open(out/'source-inputs.tar.gz','w:gz') as archive:
 for path in sorted(inputs): archive.add(r/path,arcname=path,recursive=False)
paths=[base,out]
paths.extend((r/'docs/contracts').glob('*amf*'))
paths.extend((r/'docs/contracts').glob('sol-*.md'))
paths.append(r/'docs/contracts/interfaces.zh-CN.md')
paths.append(r/'docs/performance-budget.json')
paths.extend((r/'docs/provenance').glob(f'{a.task}-*.json'))
paths.extend([r/'README.md',r/'HRNESS.md',r/'docs/codec-support-matrix.json',r/'docs/contracts/sol-model.zh-CN.md',Path(__file__)])
if a.task == 'W01':
 paths.extend([r/'HANDOFF.md',r/'docs/contracts/browser.zh-CN.md',r/'docs/adr/0002-wk-native-capabilities.zh-CN.md',r/'docs/evidence/W01/finalize-native.py'])
files=[]
for path in paths:
 files.extend([f for f in path.rglob('*') if f.is_file()] if path.is_dir() else ([path] if path.exists() else []))
index={str(path.relative_to(r)):sha(path) for path in files if path.name!='acceptance-index.json'}
save(out/'acceptance-index.json',{'taskId':a.task,'status':'PASS','capturedAt':datetime.now(timezone.utc).isoformat(),
 'managedRun':a.run,'formalTests':result['actual']['testCount'],'artifactHashes':index,'codeInputs':inputs,
 'prototypeTestNamesRetained':107,'fixedAssets':104,'productComplete':False})
print(json.dumps({'task':a.task,'formalTests':result['actual']['testCount'],'changes':len(changes),'artifacts':len(index),'sourceAndOldDataUnchanged':True}))
