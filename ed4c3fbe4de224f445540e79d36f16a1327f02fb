  vm.runInContext(source('RuffleMetadata.js'),metadataContext);
  const movie=events();const movieApi={metadata:null};let ready=false;
  const waiting=metadataContext.__flashMacOSWaitForMetadata(movie,movieApi).then(()=>ready=true);
  await new Promise(setImmediate);assert.equal(ready,false);movieApi.metadata={swfVersion:10};movie.emit('loadedmetadata');await waiting;
  assert.equal(ready,true);assert.equal(metadataTimers.size,0);
  movieApi.metadata=null;const invalid=metadataContext.__flashMacOSWaitForMetadata(movie,movieApi);const rejected=assert.rejects(invalid,/valid SWF metadata/);
  [...metadataTimers.values()][0].fn();await rejected;assert.equal(metadataTimers.size,0);
  const abandoned=metadataContext.__flashMacOSWaitForMetadata(movie,movieApi);const cancelledMetadata=assert.rejects(abandoned,{name:'AbortError'});
  metadataContext.emit('pagehide');await cancelledMetadata;assert.equal(metadataTimers.size,0);
  process.stdout.write('PASS storage cadence/pagehide and control completion/failure/cancel/closure\n');
}
main().catch(error=>{console.error(error);process.exitCode=1;});
