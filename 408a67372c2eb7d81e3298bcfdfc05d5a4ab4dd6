    [TestMethod]
    public void RegisteredRawLayoutUsesBoundedPrimitivePortsAndLogicalPayloadNode()
    {
        var codec = new AmfCodec([new RawCodec()]); var bytes = Convert.FromHexString("0a070342a5000000030080ff");
        var graph = codec.Decode(bytes, SolEncoding.Amf3); var item = (AmfObjectNode)graph.Nodes[new(0)];
        Assert.AreEqual("tests.raw.v1", item.ExternalCodecId);
