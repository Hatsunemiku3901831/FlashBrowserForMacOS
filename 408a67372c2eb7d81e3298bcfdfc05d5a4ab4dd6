    [TestMethod]
    public void AllPrefixesOfCyclicAndCompoundFixturesAreRejected()
    {
        using var manifest = JsonDocument.Parse(File.ReadAllText(Path.Combine(AmfGolden.DirectoryPath, "manifest.json")));
        foreach (var fixture in manifest.RootElement.GetProperty("fixtures").EnumerateArray().Where(item => item.GetProperty("encoding").GetInt32() == 3 && item.GetProperty("diagnostic").ValueKind == JsonValueKind.Null))
        {
            var source = AmfGolden.Bytes(fixture);
