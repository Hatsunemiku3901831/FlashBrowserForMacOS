    [TestMethod]
    public void Amf3ResourceLimitsAndCancellationAlsoApplyInsideCollections()
    {
        var codec = new AmfCodec(); var source = AmfGolden.Bytes(AmfGolden.Fixture("amf3-vector-int"));
        Assert.AreEqual("ElementLimit", Assert.ThrowsExactly<AmfFormatException>(() => codec.Decode(source, SolEncoding.Amf3, new(MaximumElements: 2))).Code);
        var nested = Convert.FromHexString(string.Concat(Enumerable.Repeat("090301", 257)) + "01");
        Assert.AreEqual("DepthLimit", Assert.ThrowsExactly<AmfFormatException>(() => codec.Decode(nested, SolEncoding.Amf3)).Code);
        using var cancellation = new CancellationTokenSource(); cancellation.Cancel();
        Assert.ThrowsExactly<OperationCanceledException>(() => codec.Decode(source, SolEncoding.Amf3, cancellationToken: cancellation.Token));
        Assert.ThrowsExactly<OperationCanceledException>(() => codec.Encode(Root(AmfNull.Instance), SolEncoding.Amf3, cancellationToken: cancellation.Token));
        var graph = codec.Decode(source, SolEncoding.Amf3);
        Assert.AreEqual("FileLimit", Assert.ThrowsExactly<AmfFormatException>(() => codec.Encode(graph, SolEncoding.Amf3, new(MaximumFileBytes: 4))).Code);
    }

    [TestMethod]
    [DataRow("0905036b03010401060378")]
    [DataRow("0a1b0354037804010379040201")]
    [DataRow("0905010d0501800000007fffffff0d02")]
    [DataRow("0905010c03000c02")]
    [DataRow("11050004010603610402060362")]
    public void MixedMembersSharedBinaryVectorsAndTypedDictionaryKeysKeepCanonicalBytes(string hex)
    {
        var codec = new AmfCodec(); var bytes = Convert.FromHexString(hex); var graph = codec.Decode(bytes, SolEncoding.Amf3);
        CollectionAssert.AreEqual(bytes, codec.Encode(graph, SolEncoding.Amf3));
        if (graph.Nodes[new(0)] is AmfDictionaryNode dictionary)
        { Assert.AreEqual(1, ((AmfInteger)dictionary.Entries[0].Key).Value); Assert.AreEqual(2, ((AmfInteger)dictionary.Entries[1].Key).Value); }
        if (graph.Nodes[new(0)] is AmfArrayNode { Associative.Count: > 0 } array)
        { Assert.AreEqual("k", array.Associative[0].Name); Assert.IsTrue(((AmfBoolean)array.Associative[0].Value).Value); Assert.HasCount(2, array.Dense); }
        if (graph.Nodes[new(0)] is AmfObjectNode item)
        { Assert.AreEqual("x", item.Traits.SealedNames[0]); Assert.AreEqual(1, ((AmfInteger)item.SealedValues[0]).Value); Assert.AreEqual("y", item.Properties[0].Name); }
    }

    [TestMethod]
    public async Task ConcurrentAndRepeatedSessionsDoNotShareReferencePools()
    {
        var codec = new AmfCodec(); var bytes = Convert.FromHexString("060378");
        await Parallel.ForAsync(0, 32, (index, token) =>
        {
            var graph = codec.Decode(bytes, SolEncoding.Amf3, cancellationToken: token);
            CollectionAssert.AreEqual(bytes, codec.Encode(graph, SolEncoding.Amf3, cancellationToken: token));
            Assert.AreEqual("InvalidStringReference", Assert.ThrowsExactly<AmfFormatException>(() => codec.Decode(Convert.FromHexString("0600"), SolEncoding.Amf3)).Code);
            return ValueTask.CompletedTask;
        });
    }

