    [TestMethod]
    public void SignedU29AllByteBoundariesHaveIndependentExpectedEncodings()
    {
        using var expected = JsonDocument.Parse(File.ReadAllText(Path.Combine(AmfGolden.DirectoryPath, "signed-u29.json")));
        var codec = new AmfCodec();
        foreach (var item in expected.RootElement.GetProperty("cases").EnumerateArray())
        {
            var bytes = Convert.FromHexString("04" + item.GetProperty("hex").GetString()); var value = item.GetProperty("value").GetInt32();
            Assert.AreEqual(value, ((AmfInteger)codec.Decode(bytes, SolEncoding.Amf3).Entries[0].Value).Value);
            CollectionAssert.AreEqual(bytes, codec.Encode(Root(new AmfInteger(value)), SolEncoding.Amf3));
            for (var length = 0; length < bytes.Length; length++)
                Assert.ThrowsExactly<AmfFormatException>(() => codec.Decode(bytes.AsMemory(0, length), SolEncoding.Amf3));
        }
    }

