    }

    [TestMethod]
    public void Amf0AvmPlusUsesRealCodecAndKeepsItsIndependentPoolsAcrossDelegates()
    {
        var codec = new AmfCodec(); var fixture = AmfGolden.Fixture("amf0-avmplus-and-following"); var bytes = AmfGolden.Bytes(fixture);
        var graph = codec.Decode(bytes, SolEncoding.Amf0); AmfGolden.AssertExpected(fixture.GetProperty("expected"), graph.Entries[0].Value, graph);
        CollectionAssert.AreEqual(bytes, codec.Encode(graph, SolEncoding.Amf0));
        bytes = Convert.FromHexString("0a0000000311060378003ff0000000000000110600");
        graph = codec.Decode(bytes, SolEncoding.Amf0); var array = (AmfArrayNode)graph.Nodes[new(0)];
        Assert.AreEqual(array.Dense[0], array.Dense[2]); CollectionAssert.AreEqual(bytes, codec.Encode(graph, SolEncoding.Amf0));
        bytes = Convert.FromHexString("0a00000002110a0b0101110a00");
        graph = codec.Decode(bytes, SolEncoding.Amf0); array = (AmfArrayNode)graph.Nodes[new(0)];
        Assert.AreEqual(array.Dense[0], array.Dense[1]); Assert.HasCount(2, graph.Nodes);
        CollectionAssert.AreEqual(bytes, codec.Encode(graph, SolEncoding.Amf0));
        var error = Assert.ThrowsExactly<AmfFormatException>(() => codec.Decode(Convert.FromHexString("110600"), SolEncoding.Amf0));
        Assert.AreEqual(SolEncoding.Amf3, error.Encoding); Assert.AreEqual(3, error.Offset);
    }

    [TestMethod]
    public void UnknownExternalizableStopsBeforeUnframedBodyAndLeavesBytesUnchanged()
    {
        var fixture = AmfGolden.Fixture("amf3-unknown-externalizable"); var bytes = AmfGolden.Bytes(fixture); var copy = (byte[])bytes.Clone();
        var error = Assert.ThrowsExactly<AmfFormatException>(() => new AmfCodec().Decode(bytes, SolEncoding.Amf3));
        Assert.AreEqual("UnknownExternalizable", error.Code); Assert.AreEqual(0, error.Offset); Assert.AreEqual((byte)0x0a, error.Marker);
        Assert.IsTrue(error.Message.Contains("unknown.Payload", StringComparison.Ordinal)); CollectionAssert.AreEqual(copy, bytes);
        var withoutBody = bytes.AsMemory(0, bytes.Length - 4);
        Assert.AreEqual("UnknownExternalizable", Assert.ThrowsExactly<AmfFormatException>(() => new AmfCodec().Decode(withoutBody, SolEncoding.Amf3)).Code);
    }

    [TestMethod]
    [DataRow("0a070354042a")]
    [DataRow("0a0703540a00")]
    [DataRow("0905010a070354042a0a0101")]
    public void RegisteredClassHasPairedCodecAndCanReferBackToItself(string hex)
    {
        var codec = new AmfCodec([new SingleValueCodec()]); var source = Convert.FromHexString(hex);
        var graph = codec.Decode(source, SolEncoding.Amf3); Assert.IsTrue(new SolDocument("custom", SolEncoding.Amf3, graph).CanEditAndSave);
        var custom = graph.Nodes.Values.OfType<AmfObjectNode>().First(); Assert.AreEqual("tests.single.v1", custom.ExternalCodecId);
        CollectionAssert.AreEqual(source, codec.Encode(graph, SolEncoding.Amf3));
        Assert.AreEqual("UnknownExternalizable", Assert.ThrowsExactly<AmfFormatException>(() => new AmfCodec().Encode(graph, SolEncoding.Amf3)).Code);
        var otherVersion = new SingleValueCodec { CodecId = "tests.single.v2" };
        Assert.AreEqual("UnknownExternalizable", Assert.ThrowsExactly<AmfFormatException>(() => new AmfCodec([otherVersion]).Encode(graph, SolEncoding.Amf3)).Code);
    }

