        CollectionAssert.AreEqual(bytes, codec.Encode(graph, SolEncoding.Amf3));
        Assert.AreEqual("NodeLimit", Assert.ThrowsExactly<AmfFormatException>(() => codec.Decode(bytes, SolEncoding.Amf3, new(MaximumNodes: 1))).Code);
    }

    [TestMethod]
    public void RegisteredLayoutFailureHasOffsetMarkerAndOriginalCause()
    {
        var bytes = Convert.FromHexString("0a070342a5ffffffff"); var copy = (byte[])bytes.Clone();
        var error = Assert.ThrowsExactly<AmfFormatException>(() => new AmfCodec([new RawCodec()]).Decode(bytes, SolEncoding.Amf3));
        Assert.AreEqual("ExternalCodecFailure", error.Code); Assert.AreEqual(0, error.Offset); Assert.AreEqual((byte)10, error.Marker);
        Assert.IsInstanceOfType<OverflowException>(error.InnerException); CollectionAssert.AreEqual(copy, bytes);
    }

    [TestMethod]
    public void RegisteredWriterFailureKeepsItsCauseAndNeverReturnsPartialBytes()
    {
        var provider = new RawCodec(); var codec = new AmfCodec([provider]);
        var graph = codec.Decode(Convert.FromHexString("0a070342a5000000030080ff"), SolEncoding.Amf3);
        provider.FailWriting = true;
        var error = Assert.ThrowsExactly<AmfFormatException>(() => codec.Encode(graph, SolEncoding.Amf3));
        Assert.AreEqual("ExternalCodecFailure", error.Code); Assert.AreEqual(0, error.Offset);
        Assert.IsInstanceOfType<FormatException>(error.InnerException);
        provider.FailWriting = false;
        Assert.AreEqual("0a070342a5000000030080ff", Convert.ToHexStringLower(codec.Encode(graph, SolEncoding.Amf3)));
    }

