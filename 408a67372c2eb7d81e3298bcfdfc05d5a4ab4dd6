    private static AmfGraph Root(AmfValue value, params AmfNode[] nodes) => new([new("", value)], nodes);
    private sealed class SingleValueCodec : IAmfExternalizableCodec
    {
        public string ClassName => "T";
        public string CodecId { get; set; } = "tests.single.v1";
        public AmfValue Read(IAmfExternalInput input) => input.ReadValue();
        public void Write(IAmfExternalOutput output, AmfValue value) => output.WriteValue(value);
    }
    private sealed class RawCodec : IAmfExternalizableCodec
    {
        public bool FailWriting { get; set; }
        public string ClassName => "B";
        public string CodecId => "tests.raw.v1";
        public AmfValue Read(IAmfExternalInput input)
        {
            if (input.ReadByte() != 0xa5) throw new FormatException("Expected synthetic raw-layout sentinel.");
            var bytes = input.ReadBytes(checked((int)input.ReadUInt32()));
            return input.AddNode(id => new AmfByteArrayNode(id, bytes.Span));
        }
        public void Write(IAmfExternalOutput output, AmfValue value)
        {
            if (FailWriting) throw new FormatException("Synthetic registered writer failure.");
            var bytes = ((AmfByteArrayNode)output.GetNode((AmfReference)value)).Bytes;
            output.WriteByte(0xa5); output.WriteUInt32((uint)bytes.Length); output.WriteBytes(bytes.Span);
        }
    }
    private sealed class NullCodec : IAmfExternalizableCodec
    {
        public string ClassName => "N";
        public string CodecId => "tests.null.v1";
        public AmfValue Read(IAmfExternalInput input) => null!;
        public void Write(IAmfExternalOutput output, AmfValue value) => Assert.Fail("Must never write a C# null payload.");
    }
