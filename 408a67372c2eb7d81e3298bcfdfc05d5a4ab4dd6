    public void ExternalCodecCannotReturnImplicitNull()
    {
        var error = Assert.ThrowsExactly<AmfFormatException>(() => new AmfCodec([new NullCodec()]).Decode(Convert.FromHexString("0a07034e"), SolEncoding.Amf3));
        Assert.AreEqual("InvalidExternalData", error.Code);
