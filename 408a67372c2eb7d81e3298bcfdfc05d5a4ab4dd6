    [TestMethod]
    public void UnsignedU29HeadersHaveExactlyTwentyNineBits()
    {
        using var writer = new AmfWriteContext(Root(AmfNull.Instance), SolEncoding.Amf3, AmfLimits.Default, new MissingAmf3Codec(), default);
        writer.WriteU29(0x1fffffff); CollectionAssert.AreEqual(Convert.FromHexString("ffffffff"), writer.ToArray());
        var reader = new AmfReadContext(writer.ToArray(), SolEncoding.Amf3, AmfLimits.Default, new MissingAmf3Codec(), default);
        Assert.AreEqual(0x1fffffffu, reader.ReadU29());
        Assert.AreEqual("U29Overflow", Assert.ThrowsExactly<AmfFormatException>(() => writer.WriteU29(0x20000000)).Code);
    }

