            {
                var error = Assert.ThrowsExactly<AmfFormatException>(() => new AmfCodec().Decode(source.AsMemory(0, length), SolEncoding.Amf3));
                Assert.IsTrue(error.Offset >= 0 && error.Offset <= length);
            }
