import pathlib
import subprocess
import unittest

class RuffleLifecycleTests(unittest.TestCase):
    def test_runtime_observers_and_control_results(self):
        root = pathlib.Path(__file__).resolve().parents[2]
        result = subprocess.run(['node', str(root / 'scripts/tests/ruffle-lifecycle.cjs')], cwd=root, capture_output=True, text=True, timeout=10)
        self.assertEqual(0, result.returncode, result.stdout + result.stderr)
