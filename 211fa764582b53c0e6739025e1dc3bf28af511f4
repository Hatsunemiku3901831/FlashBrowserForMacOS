def transform(s):
    for a, b in MAPPING.items():
        s = s.replace(a, b)
    return s

def sha(p):
    return hashlib.sha256(p.read_bytes()).hexdigest()

def write(relative, content, source=None, reason='A01 authored port/adapter composition'):
    target = ROOT / relative
    data = content.encode() if isinstance(content, str) else content
    if target.exists() and target.read_bytes() != data:
        raise ValueError('Preserving conflicting file: ' + str(target))
    target.parent.mkdir(parents=True, exist_ok=True)
    if not target.exists():
        with target.open('xb') as stream:
            stream.write(data)
    original = ROOT / 'reference/legacy/spike/macos-host' / source.relative_to(BOOT) if source and source.is_relative_to(BOOT) else None
    entries.append({
        'bootstrapSourcePath': str(source.relative_to(ROOT)) if source else None,
        'bootstrapSourceSha256': sha(source) if source else None,
        'originalSourcePath': str(original.relative_to(ROOT / 'reference/legacy')) if original and original.is_file() else None,
        'originalSourceSha256': sha(original) if original and original.is_file() else None,
        'targetPath': relative, 'targetSha256': sha(target), 'reason': reason,
    })

def copy(relative, source, edit=None, raw=False):
    value = source.read_bytes() if raw else transform(source.read_text())
    if edit:
        value = edit(value)
    write(relative, value, source, 'A01 relocate accepted P03 behavior; namespace/port adaptation; fixed assets remain byte-identical')

